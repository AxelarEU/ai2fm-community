# Calculations
Set Variable [ $fmide___callback_script_parameter[1] ; Value: Evaluate ( $fmide___callback_script_parameter ) ]
Set Variable [ $fmide___callback_script_option[1] ; Value: Evaluate ( $fmide___callback_script_option ) ]

# Action
If [ 0 ]
# SWITCH

Else If [ $fmide___callback_script_option = "Halt" ]
# Halt
Perform Script on Server with Callback [ Specified: By name ; $fmide___file_and_name ; Parameter: $fmide___script_parameter ; Callback script specified: By name ; $fmide___callback_file_and_name ; Parameter: $fmide___callback_script_parameter ; State: “Halt” ]
Else If [ $fmide___callback_script_option = "Exit" ]
# Exit
Perform Script on Server with Callback [ Specified: By name ; $fmide___file_and_name ; Parameter: $fmide___script_parameter ; Callback script specified: By name ; $fmide___callback_file_and_name ; Parameter: $fmide___callback_script_parameter ; State: “Exit” ]
Else If [ $fmide___callback_script_option = "Resume" ]
# Resume
Perform Script on Server with Callback [ Specified: By name ; $fmide___file_and_name ; Parameter: $fmide___script_parameter ; Callback script specified: By name ; $fmide___callback_file_and_name ; Parameter: $fmide___callback_script_parameter ; State: “Resume” ]
Else If [ $fmide___callback_script_option = "Pause" ]
# Pause
Perform Script on Server with Callback [ Specified: By name ; $fmide___file_and_name ; Parameter: $fmide___script_parameter ; Callback script specified: By name ; $fmide___callback_file_and_name ; Parameter: $fmide___callback_script_parameter ; State: “Pause” ]
Else
# Continue (default)
Perform Script on Server with Callback [ Specified: By name ; $fmide___file_and_name ; Parameter: $fmide___script_parameter ; Callback script specified: By name ; $fmide___callback_file_and_name ; Parameter: $fmide___callback_script_parameter ; State: “Continue” ]
End If
