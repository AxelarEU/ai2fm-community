Else If [ $fmide__action_name = "ExecuteFilemakerDataApi" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#execute-filemaker-data-api

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "request" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___request[1] ; Value: JSONGetElement ( $fmide_action ; "request" ) ]
Set Variable [ $fmide___target[1] ; Value: Case(
not IsEmpty ( JSONGetElement ( $fmide_action ; "target" ) ) ; JSONGetElement ( $fmide_action ; "target" ) ;
not IsEmpty ( JSONGetElement ( $fmide_action ; "name" ) ) ; JSONGetElement ( $fmide_action ; "name" ) ;
not IsEmpty ( JSONGetElement ( $fmide_action ; "field_name" ) ) ; JSONGetElement ( $fmide_action ; "field_name" ) ;
not IsEmpty ( JSONGetElement ( $fmide_action ; "variable_name" ) ) ; JSONGetElement ( $fmide_action ; "variable_name" )
) ]
Set Variable [ $fmide___select[1] ; Value: JSONGetElement ( $fmide_action ; "select" ) ]

# Calculations
# `.request` supports static and dynamic values
Set Variable [ $fmide___request[1] ; Value: Case( Left ( Substitute( $fmide___request ; [" " ; ""] ; [Char(9) ; ""]) ; 1 ) = "{" ; $fmide___request ; Evaluate ( $fmide___request ) ) ]
Set Variable [ $fmide___select[1] ; Value: Evaluate ( $fmide___select ) ]

# Action
If [ not IsEmpty ( $fmide___request ) ]
If [ not IsEmpty ( $fmide___target ) ]
# Target has to be indirect

# @var $fmide_response
If [ $fmide___select or IsEmpty ( $fmide___select ) ]
# Overwrite
Set Variable [ $fmide___response[1] ; Value: "" ]
Execute FileMaker Data API [ Select ; Target: $fmide___response ; $fmide___request ]
Else
# Append
Set Variable [ $fmide___response[1] ; Value: Evaluate ( $fmide___target ) ]
Execute FileMaker Data API [ Target: $fmide___response ; $fmide___request ]
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

If [ Case(
Left( $fmide___target ; 9 ) = "$fmide___" ; 0 ; 
Left( $fmide___target ; 1 ) = "$" ; Evaluate ( "Let( " & $fmide___target & "¶=$fmide___response;0)" ) ;
1
) ]
Set Field By Name [ $fmide___target ; $fmide___response ]
If [ not $$fmide_get_last_error ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
End If
End If
Else
# No target
If [ $fmide___select or IsEmpty ( $fmide___select ) ]
Execute FileMaker Data API [ Select ; $fmide___request ]
Else
Execute FileMaker Data API [ $fmide___request ]
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
End If


End If

# Reset Vars
Set Variable [ $fmide___request[1] ; Value: "" ]
Set Variable [ $fmide___response[1] ; Value: "" ]
Set Variable [ $fmide___select[1] ; Value: "" ]
Set Variable [ $fmide___target[1] ; Value: "" ]


