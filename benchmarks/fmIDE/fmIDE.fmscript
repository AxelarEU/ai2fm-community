# No target - value is url
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "url" ; $fmide_action ; $fmide__action_element_type ) ]
Set Variable [ $fmide___target[1] ; Value: "" ]
Else

# Params
Set Variable [ $fmide___target[1] ; Value: Case(
not IsEmpty ( JSONGetElement ( $fmide_action ; "target" ) ) ; JSONGetElement ( $fmide_action ; "target" ) ;
not IsEmpty ( JSONGetElement ( $fmide_action ; "name" ) ) ; JSONGetElement ( $fmide_action ; "name" ) ;
not IsEmpty ( JSONGetElement ( $fmide_action ; "field_name" ) ) ; JSONGetElement ( $fmide_action ; "field_name" ) ;
not IsEmpty ( JSONGetElement ( $fmide_action ; "variable_name" ) ) ; JSONGetElement ( $fmide_action ; "variable_name" )
) ]

If [ IsEmpty ( $fmide___target ) ]
# Process Short Form - Insert from URL.«target» = «url»
Set Variable [ $fmide__key[1] ; Value: JSONListKeys ( $fmide_action ; "" ) ]
If [ ValueCount( $fmide__key ) = 1 and

(

Position( $fmide__key ; "::" ; 1 ; 1 )

or

(
  Position( $fmide__key ; "$" ; 1 ; 1 ) and
  (
    Left( $fmide__key ; 1 ) = "$"
    or 
    Left( Substitute( $fmide__key ; [" ";""] ; [Char(9);""] ) ; 1 ) = "$" 
  )
)

) ]
Set Variable [ $fmide__key_trimmed[1] ; Value: Let ( 
[
vKey   = $fmide__key ;
vNoHWS = Substitute ( vKey ; [" ";""] ; [Char(9);""] ) ;
vChar1 = Left( vNoHWS ; 1 ) ;
vPos1  = Position ( vKey ; vChar1 ; 1 ; 1 ) ;
vCharN = Right( vNoHWS ; 1 ) ;
vPosN  = Position ( vKey ; vCharN ; Length ( vNoHWS ) ; -1 )


];

Middle ( vKey ; vPos1 ; vPosN - vPos1 + 1 )

) ]
# Use first unknown key as the variable or field name
Set Variable [ $fmide___target[1] ; Value: $fmide__key_trimmed ]
Set Variable [ $fmide__action_element_type[1] ; Value: JSONGetElementType ( $fmide_action ; $fmide__key  ) ]
Set Variable [ $fmide_action[1] ; Value: JSONGetElement ( $fmide_action ; $fmide__key  ) ]

If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "url" ; $fmide_action ; JSONString ) ]
End If
End If
End If
End If

# Defaults
If [ IsEmpty ( $fmide___target ) and not IsEmpty ( Get ( ActiveFieldName ) ) ]
Set Variable [ $fmide___target[1] ; Value: Get ( ActiveFieldTableName ) & "::" & Get ( ActiveFieldName ) ]
End If

# Params
Set Variable [ $fmide___select[1] ; Value: JSONGetElement ( $fmide_action ; "select" ) ]
Set Variable [ $fmide___with_dialog[1] ; Value: JSONGetElement ( $fmide_action ; "with_dialog" ) ]
Set Variable [ $fmide___url[1] ; Value: JSONGetElement ( $fmide_action ; "url" ) ]
Set Variable [ $fmide___curl_options[1] ; Value: JSONGetElement ( $fmide_action ; "curl_options" ) ]
Set Variable [ $fmide___do_not_automatically_encode_url[1] ; Value: JSONGetElement ( $fmide_action ; "do_not_automatically_encode_url" ) ]

# Calculations
Set Variable [ $fmide___url[1] ; Value: Evaluate ( $fmide___url ) ]
Set Variable [ $fmide___curl_options[1] ; Value: Evaluate ( $fmide___curl_options ) ]
Set Variable [ $fmide___select[1] ; Value: Evaluate ( $fmide___select ) ]
Set Variable [ $fmide___with_dialog[1] ; Value: Evaluate ( $fmide___with_dialog ) ]
Set Variable [ $fmide___do_not_automatically_encode_url[1] ; Value: Evaluate ( $fmide___do_not_automatically_encode_url ) ]

# Action
If [ not IsEmpty ( $fmide___target ) ]
# Select (=Set)
# @var $fmide___target_temp
If [ $fmide___with_dialog ]
If [ $fmide___do_not_automatically_encode_url ]
Insert from URL [ Select ; With dialog: On ; Target: $fmide___target_temp ; $fmide___url ; Do not automatically encode URL ; cURL options: $fmide___curl_options ]
Else
Insert from URL [ Select ; With dialog: On ; Target: $fmide___target_temp ; $fmide___url ; cURL options: $fmide___curl_options ]
End If
Else
If [ $fmide___do_not_automatically_encode_url ]
Insert from URL [ Select ; With dialog: Off ; Target: $fmide___target_temp ; $fmide___url ; Do not automatically encode URL ; cURL options: $fmide___curl_options ]
Else
Insert from URL [ Select ; With dialog: Off ; Target: $fmide___target_temp ; $fmide___url ; cURL options: $fmide___curl_options ]
End If
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
If [ Left( $fmide___target ; 1 ) ≠ "$fmide___" or 
Evaluate(

"Let([" & 

/* Define the var */
$fmide___target & "=Case( $fmide___select ; Evaluate( $fmide___target ) ) & $fmide___target_temp" & 

/* Log the variable name */
"¶;$fmide__local_variables = List ( $fmide__local_variables ; Case( Position ( \¶ & $fmide__local_variables & \¶ ; \¶ & $fmide___target & \¶ ; 1 ; 1 ) = 0 ; $fmide___target ) ) " & 

"¶];0)"

) ]
# Set or Append content to target field
Set Field By Name [ $fmide___target ; Case ( not $fmide___select ; GetField ( $fmide___target ) ) & $fmide___target_temp ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
End If
End If

# Reset Vars
Set Variable [ $fmide___curl_options[1] ; Value: "" ]
Set Variable [ $fmide___do_not_automatically_encode_url[1] ; Value: "" ]
Set Variable [ $fmide___select[1] ; Value: "" ]
Set Variable [ $fmide___target[1] ; Value: "" ]
Set Variable [ $fmide___target_temp[1] ; Value: "" ]
Set Variable [ $fmide___url[1] ; Value: "" ]
Set Variable [ $fmide___with_dialog[1] ; Value: "" ]


Else If [ $fmide__action_name = "InsertText" or $fmide__action_name = "InsertCalculatedResult" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#insert_calculated_script_result
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#insert_text

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
# No target
Set Variable [ $fmide___target[1] ; Value: "" ]
Else

# Params
Set Variable [ $fmide___target[1] ; Value: Case(
not IsEmpty ( JSONGetElement ( $fmide_action ; "target" ) ) ; JSONGetElement ( $fmide_action ; "target" ) ;
not IsEmpty ( JSONGetElement ( $fmide_action ; "name" ) ) ; JSONGetElement ( $fmide_action ; "name" ) ;
not IsEmpty ( JSONGetElement ( $fmide_action ; "field_name" ) ) ; JSONGetElement ( $fmide_action ; "field_name" ) ;
not IsEmpty ( JSONGetElement ( $fmide_action ; "variable_name" ) ) ; JSONGetElement ( $fmide_action ; "variable_name" )
) ]

If [ IsEmpty ( $fmide___target ) ]
# Process Short Form
Set Variable [ $fmide___keys[1] ; Value: JSONListKeys ( $fmide_action ; "" ) ]
Set Variable [ $fmide___i[1] ; Value: 1 ]
Set Variable [ $fmide___n[1] ; Value: ValueCount( $fmide___keys ) ]
Loop [ Flush type: Always ]
Exit Loop If [ $fmide___i > $fmide___n ]
Set Variable [ $fmide___key[1] ; Value: GetValue( $fmide___keys ; $fmide___i ) ]
Set Variable [ $fmide___key_trimmed[1] ; Value: Let ( 
[
vKey   = $fmide___key ;
vNoHWS = Substitute ( vKey ; [" ";""] ; [Char(9);""] ) ;
vChar1 = Left( vNoHWS ; 1 ) ;
vPos1  = Position ( vKey ; vChar1 ; 1 ; 1 ) ;
vCharN = Right( vNoHWS ; 1 ) ;
vPosN  = Position ( vKey ; vCharN ; Length ( vNoHWS ) ; -1 )


];

Middle ( vKey ; vPos1 ; vPosN - vPos1 + 1 )

) ]
If [ Left( $fmide___key_trimmed ; 1 ) = "$" or Position( $fmide___key ; "::" ; 1 ; 1 ) ]
# Use first unknown key as the variable or field name
Set Variable [ $fmide___target[1] ; Value: $fmide___key_trimmed ]
Set Variable [ $fmide__action_element_type[1] ; Value: JSONGetElementType ( $fmide_action ; $fmide___key  ) ]
Set Variable [ $fmide_action[1] ; Value: JSONGetElement ( $fmide_action ; $fmide___key  ) ]
Exit Loop If [ 1 ]
End If
Set Variable [ $fmide___i[1] ; Value: $fmide___i + 1 ]
End Loop
End If
End If

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
If [ $fmide__action_name = "InsertText" ]
# Insert Text
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "text" ; $fmide_action ; $fmide__action_element_type ) ]
Else
# Insert Calculated Result
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "calculation" ; $fmide_action ; $fmide__action_element_type ) ]
End If
End If

# Params
Set Variable [ $fmide___select[1] ; Value: JSONGetElement ( $fmide_action ; "select" ) ]
Set Variable [ $fmide___text[1] ; Value: JSONGetElement ( $fmide_action ; "text" ) ]
Set Variable [ $fmide___calculation[1] ; Value: Case(
/* text */
JSONGetElementType ( $fmide_action ; "text" ) > 0 ;
  Quote( JSONGetElement ( $fmide_action ; "text" ) ) ;
/* calc */
  JSONGetElement ( $fmide_action ; "calculation" )
) ]

# Calculations
Set Variable [ $fmide___select[1] ; Value: Evaluate ( $fmide___select ) ]
# $fmide___calculation is evaluated below

# Action
# Target field
# FIXME FIXME
If [ Case(

/* Case 1: Field or empty target **/
Left( $fmide___target ; 1 ) ≠ "$" ; 
  True ; 

/* Case 2: Target a Variable **/
Let(
[

  vDefineVar = Evaluate( "Let([" & 
    /* Define the var */
    $fmide___target & "=" & $fmide___calculation  & 
    /* Log the variable name */
    "¶;$fmide__local_variables = List ( $fmide__local_variables ; Case( Position ( \¶ & $fmide__local_variables & \¶ ; \¶ & $fmide___target & \¶ ; 1 ; 1 ) = 0 ; $fmide___target ) ) " &
    "¶];0)"
  );

  $$fmide_get_last_error        = 0 ;
  $$fmide_get_last_error_detail = "" ;
  $fmide__error_thrown = ""
  ];
  False
  )

) ]
# Target (current) field
If [ Position ( $fmide___target ; "::" ; 1 ; 1 ) ]
# Target field

# Hm… 'Target:…' does not support dynamic targets so we need to go to the field (to trigger triggers)
Perform Script [ Specified: By name ; "fmIDE" ; Parameter: "[+].Go to Field = " & Quote ( $fmide___target ) ]

Else
# No target field -> the steps will throw an error if no field is active
End If

If [ $fmide___select ]
Insert Calculated Result [ Select ; Evaluate ( $fmide___calculation ) ]
Else
Insert Calculated Result [ Evaluate ( $fmide___calculation ) ]
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
Else
# Target var
End If

# Reset Vars
Set Variable [ $fmide___calculation[1] ; Value: "" ]
Set Variable [ $fmide___i[1] ; Value: "" ]
Set Variable [ $fmide___key[1] ; Value: "" ]
Set Variable [ $fmide___key_trimmed[1] ; Value: "" ]
Set Variable [ $fmide___keys[1] ; Value: "" ]
Set Variable [ $fmide___n[1] ; Value: "" ]
Set Variable [ $fmide___select[1] ; Value: "" ]
Set Variable [ $fmide___target[1] ; Value: "" ]
Set Variable [ $fmide___text[1] ; Value: "" ]


Else If [ $fmide__action_name = "InstallOnTimerScript" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#install-on-timer-script

# Params
Set Variable [ $fmide___script_name[1] ; Value: JSONGetElement ( $fmide_action ; "script_name" ) ]
Set Variable [ $fmide___script_parameter[1] ; Value: JSONGetElement ( $fmide_action ; "script_parameter" ) ]
Set Variable [ $fmide___interval[1] ; Value: JSONGetElement ( $fmide_action ; "interval" ) ]

