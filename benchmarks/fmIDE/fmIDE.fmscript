If [ IsEmpty ( $fmide___window_name ) ]
Move/Resize Window [ Current Window; Height: $fmide___height; Width: $fmide___width; Top: $fmide___top; Left: $fmide___left ]
Else If [ $fmide___current_file_only ]
Move/Resize Window [ Name: $fmide___window_name; Current file; Height: $fmide___height; Width: $fmide___width; Top: $fmide___top; Left: $fmide___left ]
Else
Move/Resize Window [ Name: $fmide___window_name; Height: $fmide___height; Width: $fmide___width; Top: $fmide___top; Left: $fmide___left ]
