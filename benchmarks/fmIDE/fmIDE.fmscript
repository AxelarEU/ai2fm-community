Set Variable [ $fmide___callback_script_name[1] ; Value: JSONGetElement ( $fmide_action ; "callback_script_name" ) ]
Set Variable [ $fmide___callback_file_name[1] ; Value: JSONGetElement ( $fmide_action ; "callback_file_name" ) ]
Set Variable [ $fmide___callback_script_parameter[1] ; Value: JSONGetElement ( $fmide_action ; "callback_script_parameter" ) ]
Set Variable [ $fmide___callback_script_option[1] ; Value: JSONGetElement ( $fmide_action ; "callback_script_option" ) ]

