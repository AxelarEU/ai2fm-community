Else If [ $fmide__action_name = "SetWebViewer" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#set-web-viewer

Set Variable [ $fmide___object_name[1] ; Value: "" ]

# Process Short Form
If [ $fmide__action_element_type = JSONObject ]
# Process .«object_name.possibly.with.dots»…
Set Variable [ $fmide___not_parameter_names[1] ; Value: "object_name¶url" ]
Loop [ Flush type: Always ]
Set Variable [ $fmide___key[1] ; Value: JSONListKeys ( $fmide_action ; "" ) ]
If [ ValueCount( $fmide___key ) = 1 and IsEmpty ( FilterValues ( $fmide___not_parameter_names ; $fmide___key ) ) ]
# Extract object_name
Set Variable [ $fmide__action_element_type[1] ; Value: JSONGetElementType ( $fmide_action ; $fmide___key  ) ]
Set Variable [ $fmide_action[1] ; Value: JSONGetElement ( $fmide_action ; $fmide___key  ) ]
# Concatenate object_name key parts with a dot…
Set Variable [ $fmide___object_name[1] ; Value: $fmide___object_name & Case( not IsEmpty ( $fmide___object_name ) ; "." ) & $fmide___key ]
Else
# End of the line…
Set Variable [ $fmide___not_parameter_names[1] ; Value: "" ]
Set Variable [ $fmide___key[1] ; Value: "" ]
If [ not IsEmpty ( $fmide___object_name ) ]
# It will be evaluated
Set Variable [ $fmide___object_name[1] ; Value: Quote( $fmide___object_name ) ]
End If
Exit Loop If [ 1 ]
End If
End Loop
End If

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "url" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___action[1] ; Value: JSONGetElement ( $fmide_action ; "action" ) ]
If [ IsEmpty ( $fmide___object_name ) ]
Set Variable [ $fmide___object_name[1] ; Value: JSONGetElement ( $fmide_action ; "object_name" ) ]
End If
Set Variable [ $fmide___url[1] ; Value: JSONGetElement ( $fmide_action ; "url" ) ]

# Calculations
Set Variable [ $fmide___object_name[1] ; Value: Evaluate ( $fmide___object_name ) ]
Set Variable [ $fmide___url[1] ; Value: Evaluate ( $fmide___url ) ]

# Defaults
Set Variable [ $fmide___action[1] ; Value: Case (
/* Tidy */ 
not IsEmpty ( $fmide___action ) ; Substitute( $fmide___action ; ["…" ; ""] ; ["." ; ""] ) ;

/* Short Form */
not IsEmpty ( $fmide___url ) ; "Go to URL" ;

/* Default */
"Reset"
) ]

# Action
If [ IsEmpty ( $fmide___object_name ) ]
# Error
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = "Missing object name in `Set Web Viewer` action" ;
$fmide__error_thrown = 1

];

5

) ]

Else If [ $fmide___action = "Go to URL" ]
Set Web Viewer [ Object Name: $fmide___object_name ; URL: $fmide___url ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

Else If [ $fmide___action = "Reset" ]
Set Web Viewer [ Object Name: $fmide___object_name ; Action: Reset ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

Else If [ $fmide___action = "Reload" ]
Set Web Viewer [ Object Name: $fmide___object_name ; Action: Reload ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

Else If [ $fmide___action = "Go Back" ]
Set Web Viewer [ Object Name: $fmide___object_name ; Action: Go Back ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

Else If [ $fmide___action = "Go Forward" ]
Set Web Viewer [ Object Name: $fmide___object_name ; Action: Go Forward ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

Else
# Error
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = "Unknown `Set Web Viewer` action : " & $fmide___action ;
$fmide__error_thrown = 1

];

5

) ]

End If

# Reset Vars
Set Variable [ $fmide___object_name[1] ; Value: "" ]
Set Variable [ $fmide___object_name[1] ; Value: "" ]
Set Variable [ $fmide___action[1] ; Value: "" ]
Set Variable [ $fmide___url[1] ; Value: "" ]


Else If [ $fmide__action_name = "ShowCustomDialog" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#show-custom-dialog

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "message" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___message[1] ; Value: JSONGetElement ( $fmide_action ; "message" ) ]
Set Variable [ $fmide___title[1] ; Value: JSONGetElement ( $fmide_action ; "title" ) ]

Set Variable [ $fmide___buttons[1] ; Value: Case ( 

JSONGetElementType ( $fmide_action ; "buttons" ) = JSONString ;
  /* Convert simple string to buttons array */
  While ( 
  [
  vButtons = JSONGetElement ( $fmide_action ; "buttons" ) ;
  vResult = "[]" ;

  vIndex = 0 ;
  vLength = ValueCount( vButtons )

  ]; vIndex < vLength ;[


  vResult = JSONSetElement ( vResult ; vIndex ; Quote( GetValue ( vButtons ; vIndex + 1 ) ) ; JSONString ) ;
  vIndex = vIndex + 1

  ];

  vResult

  ) ;

JSONGetElementType ( $fmide_action ; "buttons" ) = JSONArray ;
  JSONGetElement ( $fmide_action ; "buttons" )

) ]
Set Variable [ $fmide___commits[1] ; Value: JSONGetElement ( $fmide_action ; "commits" ) ]

Set Variable [ $fmide___inputs[1] ; Value: Case ( 

JSONGetElementType ( $fmide_action ; "inputs" ) = JSONString ;
  /* Convert simple string to inputs array */
  While ( 
  [
  vInputs = JSONGetElement ( $fmide_action ; "inputs" ) ;
  vResult = "[]" ;

  vIndex = 0 ;
  vLength = ValueCount( vInputs )

  ]; vIndex < vLength ;[


  vResult = JSONSetElement ( vResult ; vIndex ; GetValue ( vInputs ; vIndex + 1 ) ; JSONString ) ;
  vIndex = vIndex + 1

  ];

  vResult

  ) ;

JSONGetElementType ( $fmide_action ; "inputs" ) = JSONArray ;
  JSONGetElement ( $fmide_action ; "inputs" )

) ]
Set Variable [ $fmide___labels[1] ; Value: JSONGetElement ( $fmide_action ; "labels" ) ]
// # There are 16 combinations of left, top, width, height that could occur - TOO MANY! :-/
// Set Variable [ $fmide___left[1] ; Value: JSONGetElement ( $fmide_action ; "left" ) ]
// Set Variable [ $fmide___top[1] ; Value: JSONGetElement ( $fmide_action ; "top" ) ]
// Set Variable [ $fmide___width[1] ; Value: JSONGetElement ( $fmide_action ; "width" ) ]
// Set Variable [ $fmide___height[1] ; Value: JSONGetElement ( $fmide_action ; "height" ) ]



// # Process encoded key
// Set Variable [ $fmide___keys[1] ; Value: JSONListKeys ( $fmide_action ; "" ) ]
// Set Variable [ $fmide___key[1] ; Value: Let(
// [
// 
// ¢key = GetValue( $fmide___keys ; ValueCount( Left( $fmide___keys ; Position( ¶ & $fmide___keys ; "¶message_" ; 1 ; 1 ) ) ) )
// 
// ];
// 
// Case( Position( ¢key ; "__" ; 1 ; 1 ) ; ¢key )
// 
// ) ]
// If [ not IsEmpty ( $fmide___key ) ]
// # Extended message parameter `message__button_name_list`
// Set Variable [ $fmide___message_key_bits[1] ; Value: Substitute( $fmide___key ; "__" ; "¶" ) ]
// Set Variable [ $fmide___message_key[1] ; Value: GetValue ( $fmide___message_key_bits ; 1 ) ]
// Set Variable [ $fmide___buttons[1] ; Value: Substitute( GetValue ( $fmide___message_key_bits ; 2 ); "_" ; "¶" ) ]
// If [ $fmide___message_key = "message" ]
// Set Variable [ $fmide___message[1] ; Value: JSONGetElement ( $fmide_action ; $fmide___key ) ]
// End If
// End If

# Calculations
Set Variable [ $fmide___message[1] ; Value: Evaluate( $fmide___message ) ]
Set Variable [ $fmide___title[1] ; Value: Evaluate( $fmide___title ) ]
// Set Variable [ $fmide___left[1] ; Value: Evaluate( $fmide___left ) ]
// Set Variable [ $fmide___top[1] ; Value: Evaluate( $fmide___top ) ]
// Set Variable [ $fmide___width[1] ; Value: Evaluate( $fmide___width ) ]
// Set Variable [ $fmide___height[1] ; Value: Evaluate( $fmide___height ) ]

# Defaults
Set Variable [ $fmide___buttons[1] ; Value: Case( not IsEmpty ( $fmide___buttons ) ; $fmide___buttons ; JSONSetElement ( "[]" ; 0 ; Quote( "OK" ) ; JSONString ) ) ]
Set Variable [ $fmide___commits[1] ; Value: Case( not IsEmpty ( $fmide___commits ) ; $fmide___commits ; "[1]" ) ]
Set Variable [ $fmide___inputs[1] ; Value: Case( not IsEmpty ( $fmide___inputs ) ; $fmide___inputs ; "[]" ) ]
Set Variable [ $fmide___labels[1] ; Value: Case( not IsEmpty ( $fmide___labels ) ; $fmide___labels ; "[]" ) ]

Set Variable [ $fmide___input_count[1] ; Value: ValueCount( JSONListKeys ( $fmide___inputs ; "" ) ) ]

# Output
Set Variable [ $fmide__inject_actions[1] ; Value: "[]" ]

# Action
If [ not $fmide___input_count ]
# 0 inputs
Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "Yes"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "No"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "No" ]
// # There are 16 combinations of left, top, width, height that could occur - TOO MANY! :-/
// Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "Yes"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "No"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "No"; Height: $fmide___height; Width: $fmide___width; Top: $fmide___top; Left: $fmide___left ]
Else
Set Variable [ $fmide___input1_calc[1] ; Value: JSONGetElement ( $fmide___inputs ; "[0]" ) ]
Set Variable [ $fmide___input1[1] ; Value: Evaluate( $fmide___input1_calc ) ]
If [ $fmide___input_count ≥ 2 ]
Set Variable [ $fmide___input2_calc[1] ; Value: JSONGetElement ( $fmide___inputs ; "[1]" ) ]
Set Variable [ $fmide___input2[1] ; Value: Evaluate( $fmide___input2_calc ) ]
If [ $fmide___input_count ≥ 3 ]
# 3 Inputs (more are just silently ignored)
Set Variable [ $fmide___input3_calc[1] ; Value: JSONGetElement ( $fmide___inputs ; "[2]" ) ]
Set Variable [ $fmide___input3[1] ; Value: Evaluate( $fmide___input3_calc ) ]
If [ JSONGetElement ( $fmide___commits ; "[2]" ) ]
# Commit, Commit, Commit
Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "Yes"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "Yes"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "Yes"; Input #1: $fmide___input1, Evaluate( JSONGetElement ( $fmide___labels ; "[0]" ) ); Input #2: $fmide___input2, Evaluate( JSONGetElement ( $fmide___labels ; "[1]" ) ); Input #3: $fmide___input3, Evaluate( JSONGetElement ( $fmide___labels ; "[2]" ) ) ]
Else If [ JSONGetElement ( $fmide___commits ; "[1]" ) ]
# Commit, Commit, Revert
Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "Yes"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "Yes"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "No"; Input #1: $fmide___input1, Evaluate( JSONGetElement ( $fmide___labels ; "[0]" ) ); Input #2: $fmide___input2, Evaluate( JSONGetElement ( $fmide___labels ; "[1]" ) ); Input #3: $fmide___input3, Evaluate( JSONGetElement ( $fmide___labels ; "[2]" ) ) ]
Else If [ JSONGetElement ( $fmide___commits ; "[0]" ) ]
# Commit, Revert, Revert
Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "Yes"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "No"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "No"; Input #1: $fmide___input1, Evaluate( JSONGetElement ( $fmide___labels ; "[0]" ) ); Input #2: $fmide___input2, Evaluate( JSONGetElement ( $fmide___labels ; "[1]" ) ); Input #3: $fmide___input3, Evaluate( JSONGetElement ( $fmide___labels ; "[2]" ) ) ]
Else
# Revert, Revert, Revert
Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "No"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "No"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "No"; Input #1: $fmide___input1, Evaluate( JSONGetElement ( $fmide___labels ; "[0]" ) ); Input #2: $fmide___input2, Evaluate( JSONGetElement ( $fmide___labels ; "[1]" ) ); Input #3: $fmide___input3, Evaluate( JSONGetElement ( $fmide___labels ; "[2]" ) ) ]
End If

Set Variable [ $fmide__inject_actions[1] ; Value: JSONSetElement ( $fmide__inject_actions ; "[2].Set." & $fmide___input3_calc ; Quote( $fmide___input3 ) ; JSONString ) ]
Else
# 2 Inputs
If [ JSONGetElement ( $fmide___commits ; "[2]" ) ]
# Commit, Commit, Commit
Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "Yes"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "Yes"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "Yes"; Input #1: $fmide___input1, Evaluate( JSONGetElement ( $fmide___labels ; "[0]" ) ); Input #2: $fmide___input2, Evaluate( JSONGetElement ( $fmide___labels ; "[1]" ) ) ]
Else If [ JSONGetElement ( $fmide___commits ; "[1]" ) ]
# Commit, Commit, Revert
Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "Yes"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "Yes"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "No"; Input #1: $fmide___input1, Evaluate( JSONGetElement ( $fmide___labels ; "[0]" ) ); Input #2: $fmide___input2, Evaluate( JSONGetElement ( $fmide___labels ; "[1]" ) ) ]
Else If [ JSONGetElement ( $fmide___commits ; "[0]" ) ]
# Commit, Revert, Revert
Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "Yes"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "No"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "No"; Input #1: $fmide___input1, Evaluate( JSONGetElement ( $fmide___labels ; "[0]" ) ); Input #2: $fmide___input2, Evaluate( JSONGetElement ( $fmide___labels ; "[1]" ) ) ]
Else
# Revert, Revert, Revert
Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "No"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "No"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "No"; Input #1: $fmide___input1, Evaluate( JSONGetElement ( $fmide___labels ; "[0]" ) ); Input #2: $fmide___input2, Evaluate( JSONGetElement ( $fmide___labels ; "[1]" ) ) ]
End If
End If
Set Variable [ $fmide__inject_actions[1] ; Value: JSONSetElement ( $fmide__inject_actions ; "[1].Set." & $fmide___input2_calc ; Quote ( $fmide___input2 ) ; JSONString ) ]
Else
# 1 input
If [ JSONGetElement ( $fmide___commits ; "[2]" ) ]
# Commit, Commit, Commit
Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "Yes"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "Yes"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "Yes"; Input #1: $fmide___input1, Evaluate( JSONGetElement ( $fmide___labels ; "[0]" ) ) ]
Else If [ JSONGetElement ( $fmide___commits ; "[1]" ) ]
# Commit, Commit, Revert
Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "Yes"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "Yes"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "No"; Input #1: $fmide___input1, Evaluate( JSONGetElement ( $fmide___labels ; "[0]" ) ) ]
Else If [ JSONGetElement ( $fmide___commits ; "[0]" ) ]
# Commit, Revert, Revert
Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "Yes"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "No"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "No"; Input #1: $fmide___input1, Evaluate( JSONGetElement ( $fmide___labels ; "[0]" ) ) ]
Else
# Revert, Revert, Revert
Show Custom Dialog [ Title: $fmide___title; Message: $fmide___message; Default Button: Evaluate( JSONGetElement ( $fmide___buttons ; "[0]" ) ), Commit: "No"; Button 2: Evaluate( JSONGetElement ( $fmide___buttons ; "[1]" ) ), Commit: "No"; Button 3: Evaluate( JSONGetElement ( $fmide___buttons ; "[2]" ) ), Commit: "No"; Input #1: $fmide___input1, Evaluate( JSONGetElement ( $fmide___labels ; "[0]" ) ) ]
End If
End If
Set Variable [ $fmide__inject_actions[1] ; Value: JSONSetElement ( $fmide__inject_actions ; "[0].Set." & $fmide___input1_calc ; Quote( $fmide___input1 ) ; JSONString ) ]
End If

Set Variable [ $fmide_last_message_choice[1] ; Value: Get( LastMessageChoice ) ]
If [ not JSONGetElement ( $fmide___commits ; "[" & ($fmide_last_message_choice - 1) & "]" ) ]
# No commit
Set Variable [ $fmide__inject_actions[1] ; Value: "" ]
// Show Custom Dialog [ Title: "DEBUG"; Message: $fmide___commits; Default Button: "OK", Commit: "Yes" ]
End If

# Reset Vars
Set Variable [ $fmide___buttons[1] ; Value: "" ]
Set Variable [ $fmide___commits[1] ; Value: "" ]
Set Variable [ $fmide___input1[1] ; Value: "" ]
Set Variable [ $fmide___input1_calc[1] ; Value: "" ]
Set Variable [ $fmide___input2[1] ; Value: "" ]
Set Variable [ $fmide___input2_calc[1] ; Value: "" ]
Set Variable [ $fmide___input3[1] ; Value: "" ]
Set Variable [ $fmide___input3_calc[1] ; Value: "" ]
Set Variable [ $fmide___inputs[1] ; Value: "" ]
Set Variable [ $fmide___input_count[1] ; Value: "" ]
Set Variable [ $fmide___labels[1] ; Value: "" ]
Set Variable [ $fmide___message[1] ; Value: "" ]
Set Variable [ $fmide___title[1] ; Value: "" ]
Set Variable [ $fmide___left[1] ; Value: "" ]
Set Variable [ $fmide___top[1] ; Value: "" ]
Set Variable [ $fmide___width[1] ; Value: "" ]
Set Variable [ $fmide___height[1] ; Value: "" ]


Else If [ $fmide__action_name = "ShowHideToolbars" or
$fmide__action_name = "ShowToolbars" or
$fmide__action_name = "HideToolbars" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#show-hide-toolbars

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}"
;["state" ; Trim( Substitute ( $fmide_action ; ["unlock" ; ""] ; ["lock" ; ""] ) ) ; $fmide__action_element_type ]
;["lock"  ; Position ( $fmide_action ; "lock" ; 1 ; 1 ) and not Position ( $fmide_action ; "unlock" ; 1 ; 1 ) ; JSONBoolean ]
) ]
End If

# Params
Set Variable [ $fmide___lock[1] ; Value: JSONGetElement ( $fmide_action ; "lock" ) ]
Set Variable [ $fmide___state[1] ; Value: JSONGetElement ( $fmide_action ; "state" ) ]

# Calculate state
Set Variable [ $fmide___state[1] ; Value: Case(
$fmide__action_name = "ShowToolbars" ; "Show" ;
$fmide__action_name = "HideToolbars" ; "Hide" ;
not IsEmpty ( $fmide___state ) ; Substitute ( $fmide___state ; [1;"Show"] ; [0;"Hide"] ) ;
"Toggle"
) ]
Set Variable [ $fmide___lock[1] ; Value: Evaluate ( $fmide___lock ) ]

# Action
If [ $fmide___lock ]
If [ $fmide___state = "Hide" ]
Show/Hide Toolbars [ Lock ; Hide ]
Else If [ $fmide___state = "Show" ]
Show/Hide Toolbars [ Lock ; Show ]
Else
Show/Hide Toolbars [ Lock ; Toggle ]
End If
Else
If [ $fmide___state = "Hide" ]
Show/Hide Toolbars [ Hide ]
Else If [ $fmide___state = "Show" ]
Show/Hide Toolbars [ Show ]
Else
Show/Hide Toolbars [ Toggle ]
End If
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Reset Vars
Set Variable [ $fmide___lock[1] ; Value: "" ]
Set Variable [ $fmide___state[1] ; Value: "" ]


Else If [ $fmide__action_name = "StoreKeyboardBuffer" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#store-keyboard-buffer

# Writes the text (with optional line feed) to the fmIDE keyboard buffer file in the documents folder

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "text" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___text[1] ; Value: JSONGetElement ( $fmide_action ; "text" ) ]
Set Variable [ $fmide___append_line_feed[1] ; Value: JSONGetElement ( $fmide_action ; "append_line_feed" ) ]

# Calculations
# FIXME text?
Set Variable [ $fmide___append_line_feed[1] ; Value: Evaluate ( $fmide___append_line_feed ) ]


# Action
Set Variable [ $fmide___folder_path[1] ; Value: Get ( DocumentsPath ) ]
Set Variable [ $fmide___file_name[1] ; Value: "fmIDE_keyboard_buffer.txt" ]
Set Variable [ $fmide___file_path[1] ; Value: $fmide___folder_path & $fmide___file_name ]

# First delete the file if it exists
# @var $fmide___file_exists
Get File Exists [ "$fmide___file_path" ; Target: $fmide___file_exists ]
If [ $fmide___file_exists ]
Delete File [ Target file: “$fmide___file_path” ]
End If

# Then create the file with text and optional EOL
Create Data File [ "$fmide___file_path" ; Create folders: On ]

# @var $fmide___file_id
Open Data File [ "$fmide___file_path" ; Target: $fmide___file_id ]
If [ $fmide___append_line_feed ]
Write to Data File [ File ID: $fmide___file_id ; Data source: $fmide___text[1] ; Write as: UTF-8 ; Append line feed: On ]
Else
Write to Data File [ File ID: $fmide___file_id ; Data source: $fmide___text[1] ; Write as: UTF-8 ; Append line feed: Off ]
End If
Close Data File [ File ID: $fmide___file_id ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Reset Vars
Set Variable [ $fmide___append_line_feed[1] ; Value: "" ]
Set Variable [ $fmide___file_exists[1] ; Value: "" ]
Set Variable [ $fmide___file_id[1] ; Value: "" ]
Set Variable [ $fmide___file_name[1] ; Value: "" ]
Set Variable [ $fmide___file_path[1] ; Value: "" ]
Set Variable [ $fmide___folder_path[1] ; Value: "" ]
Set Variable [ $fmide___text[1] ; Value: "" ]


Else If [ $fmide__action_name = "UndoRedo" or $fmide__action_name = "Undo" or $fmide__action_name = "Redo" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#undo-redo
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#undo
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#redo

# Action
If [ 0 ]
# Switch
Else If [ $fmide__action_name = "Undo" ]
Undo/Redo [ Undo ]
Else If [ $fmide__action_name = "Redo" ]
Undo/Redo [ Redo ]
Else If [ $fmide__action_name = "UndoRedo" ]
Undo/Redo [ Toggle ]
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]


Else If [ $fmide__action_name = "UnsortRecords" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#unsort-records

# Action
Unsort Records
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]


Else If [ $fmide__action_name = "ViewAs" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#view-as

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "value" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___value[1] ; Value: JSONGetElement ( $fmide_action ; "value" ) ]

# Calculations
Set Variable [ $fmide___value[1] ; Value: Evaluate ( $fmide___value ) ]

# Default
Set Variable [ $fmide___value[1] ; Value: Case ( not IsEmpty ( $fmide___value ) ; $fmide___value ; "Cycle" ) ]

# Action
If [ 0 ]
# Switch
Else If [ $fmide___value = "Form" ]
View As [ View as Form ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
Else If [ $fmide___value = "List" ]
View As [ View as List ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
Else If [ $fmide___value = "Table" ]
View As [ View as Table ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
Else If [ $fmide___value = "Cycle" ]
View As [ Cycle ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
Else
# Error
# FIXME
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
End If

# Reset Vars
Set Variable [ $fmide___value[1] ; Value: "" ]


Else If [ $fmide__action_name = "WriteToDataFile" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#write-to-data-file

# Params
Set Variable [ $fmide___file_id[1] ; Value: JSONGetElement ( $fmide_action ; "file_id" ) ]
Set Variable [ $fmide___data_source[1] ; Value: JSONGetElement ( $fmide_action ; "data_source" ) ]
Set Variable [ $fmide___append_line_feed[1] ; Value: JSONGetElement ( $fmide_action ; "append_line_feed" ) ]
Set Variable [ $fmide___write_as[1] ; Value: JSONGetElement ( $fmide_action ; "write_as" ) ]

# Calculations
Set Variable [ $fmide___file_id[1] ; Value: Evaluate ( $fmide___file_id ) ]
Set Variable [ $fmide___data_source[1] ; Value: Evaluate ( $fmide___data_source ) ]
Set Variable [ $fmide___append_line_feed[1] ; Value: Evaluate ( $fmide___append_line_feed ) ]

# Defaults
If [ IsEmpty ( $fmide___file_id ) ]
# Default to last file opened
Set Variable [ $fmide___file_id[1] ; Value: LeftWords ( RightValues ( Get ( OpenDataFileInfo ) ; 1 ) ; 1 ) ]
End If

# Action
If [ Abs( $fmide___write_as ) = 16 ]
# UTF-16
If [ $fmide___append_line_feed ]
# With line feeds
Write to Data File [ File ID: $fmide___file_id ; Data source: $fmide___data_source[1] ; Write as: UTF-16 ; Append line feed: On ]
Else
Write to Data File [ File ID: $fmide___file_id ; Data source: $fmide___data_source[1] ; Write as: UTF-16 ; Append line feed: Off ]
End If
Else
# UTF-8 (default)
If [ $fmide___append_line_feed ]
# With line feeds
Write to Data File [ File ID: $fmide___file_id ; Data source: $fmide___data_source[1] ; Write as: UTF-8 ; Append line feed: On ]
Else
Write to Data File [ File ID: $fmide___file_id ; Data source: $fmide___data_source[1] ; Write as: UTF-8 ; Append line feed: Off ]
End If
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Reset Vars
Set Variable [ $fmide___append_line_feed[1] ; Value: "" ]
Set Variable [ $fmide___data_source[1] ; Value: "" ]
Set Variable [ $fmide___file_id[1] ; Value: "" ]
Set Variable [ $fmide___write_as[1] ; Value: "" ]


Else
# unknown action => skip
Set Variable [ $$fmide_get_last_error[1] ; Value: -1 ]
Set Variable [ $$fmide_get_last_error_detail[1] ; Value: "Unknown action '" & $fmide__action_name & "'" ]
Set Variable [ $fmide__error_thrown[1] ; Value: 1 ]

End If
End If
End If

# # END TRY (fmIDE error handling)
Exit Loop If [ 1 ]
End Loop

If [ not $fmide__skipped ]
# # CATCH (fmIDE error handling)
If [ $$fmide_get_last_error ]
If [ $$fmide_get_error_capture_state ]
# ignore errors
Else If [ $fmide__error_thrown ]
# catch *newly thrown* errors
Set Variable [ $$fmide_get_last_error_location[1] ; Value: $fmide__action_index+1 ]
Show Custom Dialog [ Title: $fmide_dialog_title; Message: "fmIDE error @ line " & $$fmide_get_last_error_location & ": Error " & $$fmide_get_last_error & " " & $$fmide_get_last_error_detail; Default Button: "OK", Commit: "Yes"; Button 2: Case( $$fmide_get_allow_abort_state ; "Exit Script" ), Commit: "No"; Button 3: Case ( $$fmide_get_allow_abort_state ; "HALT" ), Commit: "No" ]
If [ Get ( LastMessageChoice ) = 2 ]
# 2: Cancel
If [ Get ( ActiveModifierKeys ) = 1+8 /* SHIFT-ALT for pause for debug */ ]
Pause/Resume Script [ Indefinitely ]
Else
Set Variable [ $fmide__script_result[1] ; Value: JSONSetElement ( "{}"
;["fmide_get_last_error" ; $$fmide_get_last_error ; JSONNumber]
;["fmide_get_last_error_detail" ; $$fmide_get_last_error_detail ; JSONString]
) ]
# Inject an Exit Script action
Set Variable [ $fmide__inject_actions[1] ; Value: JSONSetElement ( "[]" ; "[0].Exit Script" ; "$fmide__script_result" ; JSONString ) ]
End If
Else If [ Get ( LastMessageChoice ) = 3 ]
# 3: HALT
Halt Script
Else
# 1: OK
End If
End If
# # END CATCH
End If
End If

# # Pause on Error

If [ $fmide__error_thrown ]
If [ $fmide_pause_on_error and $$fmide_get_error_capture_state ]
# pause on error
Set Variable [ $fmide_debugger[1] ; Value: 1 ]
End If
Set Variable [ $fmide__error_thrown[1] ; Value: "" ]
End If

# # Action Injection

# Inject actions (used to expand convenience actions into real actions, e.g. `Get Version`-> `Exit Script (version number)`)
If [ not IsEmpty ( $fmide__inject_actions ) and $fmide__inject_actions ≠ "[]" ]
# Inject code into the action script directly after the current step

# Remember the current action and change it to a uuid
Set Variable [ $fmide___uuid[1] ; Value: Get (UUID ) ]
Set Variable [ $fmide_action[1] ; Value: JSONGetElement ( $fmide_actions ; $fmide__action_index ) ]
Set Variable [ $fmide_actions[1] ; Value: JSONSetElement ( $fmide_actions ; "[" & $fmide__action_index & "]" ; $fmide___uuid ; JSONString ) ]

# Construct the replacement code from the current step and the code to inject, and inject it
Set Variable [ $fmide__replace_code[1] ; Value: $fmide_action & "," & Middle ( $fmide__inject_actions ; 2 ; Length ( $fmide__inject_actions ) -2 ) ]
Set Variable [ $fmide_actions[1] ; Value: Substitute ( $fmide_actions ; Quote ( $fmide___uuid ) ; $fmide__replace_code )// & Case( $fmide__action_index < $fmide__action_index_max - 1 ; "," ) ) ]
Set Variable [ $fmide__action_index_max[1] ; Value: $fmide__action_index_max + ValueCount ( JSONListKeys ( $fmide__inject_actions ; "" ) ) ]

# Tidy up
Set Variable [ $fmide__inject_actions[1] ; Value: "" ]
Set Variable [ $fmide___uuid[1] ; Value: "" ]
End If

# NEXT actions_index
Set Variable [ $fmide__action_index[1] ; Value: $fmide__action_index + 1 ]

If [ $fmide__continuation_halt_for_seconds ]
# # Prepare Hiatus

# Only continue, if there is anything to continue with!
If [ $fmide__action_index < $fmide__action_index_max ]
# ## Continuation for Hiatus - This is where the magic *really* starts 🪄
Set Variable [ $fmide__continuation[1] ; Value: JSONSetElement ( "{}"
;["actions" ; $fmide_actions ; JSONArray]
;["action_stack" ; $fmide__action_stack ; JSONArray]
;["action_stack_top" ; $fmide__action_stack_top ; JSONString]
;["action_block" ; $fmide__action_block ; JSONString]
;["action_skip"  ; $fmide__action_skip  ; JSONString]
;["action_index" ; $fmide__action_index ; JSONNumber]
;["action_index_max" ; $fmide__action_index_max ; JSONNumber]
;["fmide_local_variables" ; $fmide__local_variables ; JSONString]
;["original_layout_number" ; $fmide__original_layout_number ; JSONNumber]
;["original_window_name" ; $fmide__original_window_name ; JSONString]
) ]
Set Variable [ $fmide__local_variables[1] ; Value: While(
[

¢vars = $fmide__local_variables ;
¢i = 1;
¢n = ValueCount ( ¢vars )

]; ¢i <= ¢n ;[

¢var = Substitute( GetValue ( ¢vars ; ¢i ) ; "$" ; "" ) ;

¢expression = "
  Let([
  $$fmide_local_variable_" & ¢var & "=$" & ¢var & "¶
  ];
  \"\”
  )" ;
$$expression = ¢expression;
/* Redfine the variable as a global variable */
¢ignore_errors = Evaluate ( ¢expression ) ;

¢i = ¢i + 1

];

""

) ]
Set Variable [ $$fmide__continuation_mbs_schedule_ref[1] ; Value: MBS( "Schedule.StartScriptAfterDelay"; $fmide__continuation_halt_for_seconds + Case( Div ( Get ( CurrentTimeUTCMilliseconds ) ; 1000 ) > 500 ; 1 ) ; /* +1 Workaround - the  MBS functon seems to be about 1  second too slow! */
Get ( FileName ) ;
Get ( ScriptName ) ;
JSONSetElement ( "{}" ; "continuation" ; $fmide__continuation ; JSONObject )
) ]
End If

If [ not IsEmpty ( $fmide__idle_calc_expression ) ]
# ## Idle Calc expression
# Here an expression is evaluated, causing something to happen in idle time, e.g. PasteIntoCurrentLayout
Set Variable [ $fmide__r[1] ; Value: Evaluate ( $fmide__idle_calc_expression ) ]
End If
Halt Script
End If
End Loop

# # fmIDE Debugger final message
If [ $fmide_debugger ]
Show Custom Dialog [ Title: "fmIDE Debugger"; Message: "[" & $fmide__action_index & "]/" & $fmide__action_index_max & " " & "Finished¶" & 
Case( $$fmide_get_last_error ; "Error: " & $$fmide_get_last_error ) &
Case( not IsEmpty ( $$fmide_get_last_error ) ; " (" & $$fmide_get_last_error_detail & ")" ); Default Button: "Continue", Commit: "Yes"; Button 2: "Pause", Commit: "No"; Button 3: "HALT", Commit: "No" ]
If [ Get ( LastMessageChoice ) = 2 ]
# Pause
Pause/Resume Script [ Indefinitely ]
Else If [ Get ( LastMessageChoice ) = 3 ]
Halt Script
End If
End If

# # Finished
# The fmIDE action script exits here with no Exit Script and no ScriptResult, when the fmIDEAS finishes without having encountered an Exit Script step.

# About the last line
#> 
#> - It always pays to have an empty last comment line in a script, so you can skip to the last line with the debugger, if you want
