# Action

# ## Open the script workspace

Open Script Workspace
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
Exit Loop If [ Case( $$fmide_get_last_error ; Let( $$fmide_get_last_error_detail = "ScriptWorkSpace could not be opened." ; 1 ) ) ]

If [ $fmide__is_win or not $fmide__is_mbs ]
# ## Windows / no MBS => stop here
Set Variable [ $$fmide_get_last_error[1] ; Value: 9 ]
Set Variable [ $$fmide_get_last_error_detail[1] ; Value: "ScriptWorkSpace GUI interaction needs Mac + MBS plugin." ]
Set Variable [ $fmide__error_thrown[1] ; Value: 1 ]
Exit Loop If [ 1 ]
End If

# ## vvvvvvv Mac+MBS-only vvvvvvv

# Make sure the script workspace is at the front

Set Variable [ $fmide___r[1] ; Value: MBS("ScriptWorkspace.BringToFront") ]
If [ MBS("IsError") ]
# Can't open ScriptWorkSpace
Set Variable [ $$fmide_get_last_error[1] ; Value: 9 ]
Set Variable [ $$fmide_get_last_error_detail[1] ; Value: "Can't bring ScriptWorkSpace to the front." ]
Set Variable [ $fmide__error_thrown[1] ; Value: 1 ]
Exit Loop If [ 1 ]
End If


If [ not IsEmpty ( $fmide___script_search ) ]
# Search scripts
Set Variable [ $fmide___r[1] ; Value: MBS( "ScriptWorkspace.SetScriptListSearch" ; $fmide___script_search ) ]
End If

If [ not IsEmpty ( $fmide___script_name ) ]
If [ $fmide__action_name = "SelectScriptFolder" ]
# Select a folder
Set Variable [ $fmide___r[1] ; Value: MBS( "ScriptWorkspace.SelectGroup"; $fmide___script_name ; 1 ) ]
Else
# Open the script - permanently
Set Variable [ $fmide___r[1] ; Value: MBS("ScriptWorkspace.OpenScript" ; $fmide___script_name ) ]
If [ MBS("IsError") ]
# Make sure the Script list is visible
# …not yet possible in MBS
# Make sure ALL scripts are being shown
Set Variable [ $fmide___r[1] ; Value: MBS( "ScriptWorkspace.ExpandScriptFolders" ) ]
If [ MBS("IsError") ]
# Maybe we need to open all script folders
Set Variable [ $fmide___r[1] ; Value: MBS( "ScriptWorkspace.ExpandScriptFolders" ) ]
End If

# Try again
Set Variable [ $fmide___r[1] ; Value: MBS("ScriptWorkspace.OpenScript" ; $fmide___script_name ) ]
If [ MBS("IsError") ]
# Error
Set Variable [ $$fmide_get_last_error[1] ; Value: 104 ]
Set Variable [ $$fmide_get_last_error_detail[1] ; Value: "Error: " & $fmide___r //& " - Couldn't find script \"" & $fmide___script_name & "\"" ]
Set Variable [ $fmide__error_thrown[1] ; Value: 1 ]
Exit Loop If [ 1 ]
End If
End If
End If
End If

