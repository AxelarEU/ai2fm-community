Else If [ $fmide__action_name = "OpenFile" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#open-file

# TRYING to emulate an Open File step

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "file" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___file[1] ; Value: JSONGetElement ( $fmide_action ; "file" ) ]
Set Variable [ $fmide___hidden[1] ; Value: JSONGetElement ( $fmide_action ; "hidden" ) ]

# Calculations
Set Variable [ $fmide___file[1] ; Value: Evaluate ( $fmide___file ) ]
Set Variable [ $fmide___hidden[1] ; Value: Evaluate ( $fmide___hidden ) ]

# Action
If [ $fmide___file = "[Self]" ]
# THIS file has been (force) opened by calling the fmIDE script with  fmJAML `[+].Open File = == [Self]`
# FIXME … Start script must be run (IFF not already run and file not hidden)

# Indicate that the opening was succesful
Set Variable [ $fmide__script_result[1] ; Value: JSONSetElement ( "{}" ; "file_opened" ; True ; JSONBoolean ) ]
# Inject an Exit Script action
Set Variable [ $fmide__inject_actions[1] ; Value: JSONSetElement ( "[]" ; "[0].Exit Script" ; "$fmide__script_result" ; JSONString ) ]
Else
# Open File = == «file»

# TRY
Loop [ Flush type: Always ]
# ## 1. First try via custom script…
Perform Script [ Specified: By name ; "fmIDE.OpenFile" ; Parameter: JSONSetElement ( "{}"
;["file" ; $fmide___file ; JSONString]
;["hidden" ; $fmide___hidden ; JSONString]
) ]
If [ Get ( LastError ) = 104 ]
# Script not present -> try next method
Else
Set Variable [ $fmide___jsr[1] ; Value: Case ( not IsEmpty ( Get ( ScriptResult ) ) ; Get ( ScriptResult ) ; "{}" ) ]
Set Variable [ $fmide___file_opening[1] ; Value: JSONGetElement ( $fmide___jsr ; "file_opening" ) ]
Exit Loop If [ $fmide___file_opening ]
# File not present in subscript -> try next method
End If

# ## 2. Then try by fmIDE Script call
Perform Script [ Specified: By name ; $fmide___file & "::fmIDE" ; Parameter: "[+].Open File = == [Self]" ]
If [ Get ( LastError ) = 100 ]
# File not present -> try next method
Else If [ Get ( LastError ) = 104 ]
# fmIDE Script not present -> try next method
# …or is the file open anyhow?
Else
# Read success result
Set Variable [ $fmide___jsr[1] ; Value: Case ( not IsEmpty ( Get ( ScriptResult ) ) ; Get ( ScriptResult ) ; "{}" ) ]
Set Variable [ $fmide___file_opened[1] ; Value: JSONGetElement ( $fmide___jsr ; "file_opened" ) ]
Exit Loop If [ $fmide___file_opened ]
# File not opened by subscript -> try next method
End If
Exit Loop If [ not (
Get ( LastError ) = 104 or /* script is missing */
Get ( LastError ) = 100 or /* file is missing */
Get ( LastError ) = 0 and JSONGetElement ( Get ( ScriptResult ) ; "fmide_get_last_error" ) ≠ 0
) ]

# ## 3. Finally try by fmpurl
Set Variable [ $fmide___current_file_path[1] ; Value: Get ( FilePath ) ]
Set Variable [ $fmide___host[1] ; Value: Get ( HostIPAddress ) ]
Set Variable [ $fmide___fmpurl[1] ; Value: Case (
/* hosted file */
LeftWords ( $fmide___current_file_path ; 1 ) = "fmnet" ; 
"fmp://" & Get ( HostIPAddress ) & "/" & $fmide___file ;


/* local file */
ConvertFromFileMakerPath ( 
Substitute ( Get ( FilePath ) ; Get ( FileName ) & ".fmp12" ; $fmide___file & ".fmp12" ) 
; URLPath )

) ]
Open URL [ With dialog: Off ; $fmide___fmpurl ]

# Pause for a moment to allow fmpurl to work…
Pause/Resume Script [ Duration (seconds): 1 ]

If [ IsEmpty ( FilterValues ( DatabaseNames ; $fmide___file ) ) ]
# Error - file not opened
# Error 100 - file is missing
Set Variable [ $$fmide_get_last_error[1] ; Value: Let( $$fmide_get_last_error_detail = "File is missing: '" & $fmide___file & "'"  ; 100 ) ]
Exit Loop If [ 1 ]
End If

# END TRY
Exit Loop If [ True ]
End Loop
# FIXME
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
End If

# Reset Vars
Set Variable [ $fmide___current_file_path[1] ; Value: "" ]
Set Variable [ $fmide___file[1] ; Value: "" ]
Set Variable [ $fmide___file_opened[1] ; Value: "" ]
Set Variable [ $fmide___file_opening[1] ; Value: "" ]
Set Variable [ $fmide___fmpurl[1] ; Value: "" ]
Set Variable [ $fmide___hidden[1] ; Value: "" ]
Set Variable [ $fmide___host[1] ; Value: "" ]
Set Variable [ $fmide___jsr[1] ; Value: "" ]


