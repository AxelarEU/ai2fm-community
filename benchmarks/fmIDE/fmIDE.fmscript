# Action
Insert Text [ Select ; $fmide__idle_calc_expression ; “MBS( $fmide__mbs_remote_control_press_command_or_control_key ; 1 ) & 
MBS( "RemoteControl.PressKey" ; "c" ; "c" ) & 
MBS( $fmide__mbs_remote_control_press_command_or_control_key ; 0 ) &
""” ]
