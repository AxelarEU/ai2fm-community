Set Variable [ $fmide___amount[1] ; Value: Evaluate ( $fmide___amount ) ]

# Defaults
If [ IsEmpty ( $fmide___file_id ) ]
# Default to last file opened
Set Variable [ $fmide___file_id[1] ; Value: LeftWords ( RightValues ( Get ( OpenDataFileInfo ) ; 1 ) ; 1 ) ]
End If

# Action
If [ $fmide___read_as = "Bytes" ]
# Bytes
Read from Data File [ File ID: $fmide___file_id ; Amount (bytes): $fmide___amount ; Target: $fmide___target_temp ; Read as: Bytes ]
Else If [ Abs ( $fmide___read_as ) = 16 ]
# UTF-16
Read from Data File [ File ID: $fmide___file_id ; Amount: $fmide___amount ; Target: $fmide___target_temp ; Read as: UTF-16 ]
// Else If [ GetAsNumber ( $fmide___read_as ) = 8 ]
Else
# UTF-8 (default)
Read from Data File [ File ID: $fmide___file_id ; Amount (bytes): $fmide___amount ; Target: $fmide___target_temp ; Read as: UTF-8 ]
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

If [ $$fmide_get_last_error = 0 ]
# Target is only set if successfully opened
If [ Left( $fmide___target ; 1 ) ≠ "$" or 
Evaluate(

"Let([" & 

/* Define the var */
$fmide___target & "=$fmide___target_temp" & 

/* Log the variable name */
"¶;$fmide__local_variables = List ( $fmide__local_variables ; Case( Position ( \¶ & $fmide__local_variables & \¶ ; \¶ & $fmide___target & \¶ ; 1 ; 1 ) = 0 ; $fmide___target ) ) " & 

"¶];0)"

) ]
# Set or Append content to target field
Set Field By Name [ $fmide___target ; $fmide___target_temp ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
End If
End If

