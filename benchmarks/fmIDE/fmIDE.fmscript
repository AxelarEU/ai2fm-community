) ]


Else If [ $fmide__action_name = "PerformScript" or $fmide__action_name = "PerformScriptOnServer" or $fmide__action_name = "PerformScriptOnServerWithCallback" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#perform-script

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "script_name" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___by[1] ; Value: JSONGetElement ( $fmide_action ; "by" ) ]
Set Variable [ $fmide___script_name[1] ; Value: JSONGetElement ( $fmide_action ; "script_name" ) ]
Set Variable [ $fmide___file_name[1] ; Value: JSONGetElement ( $fmide_action ; "file_name" ) ]
Set Variable [ $fmide___script_parameter[1] ; Value: JSONGetElement ( $fmide_action ; "script_parameter" ) ]

# Calculations
If [ $fmide___by = "name" ]
# Only evaluate the script-name if "by:name"
Set Variable [ $fmide___script_name[1] ; Value: Evaluate ( $fmide___script_name ) ]
End If
Set Variable [ $fmide___script_parameter[1] ; Value: Evaluate ( $fmide___script_parameter ) ]

# Defaults
Set Variable [ $fmide___file_and_name[1] ; Value: Case ( not IsEmpty ( $fmide___file_name ) ; $fmide___file_name & "::" ) & $fmide___script_name ]

# Action
If [ 0 ]
# Switch

Else If [ $fmide__action_name = "PerformScript" ]
Perform Script [ Specified: By name ; $fmide___file_and_name ; Parameter: $fmide___script_parameter ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

Else If [ $fmide__action_name = "PerformScriptOnServer" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#perform-script-on-server

# Params
Set Variable [ $fmide___wait_for_completion[1] ; Value: JSONGetElement ( $fmide_action ; "wait_for_completion" ) ]

# Calculations
Set Variable [ $fmide___wait_for_completion[1] ; Value: Evaluate ( $fmide___wait_for_completion ) ]

If [ not $fmide___wait_for_completion ]
# Don't wait / Asynchronous call
Perform Script on Server [ Specified: By name ; $fmide___file_and_name ; Parameter: $fmide___script_parameter ; Wait for completion: Off ]
Else
# Wait (default)
Perform Script on Server [ Specified: By name ; $fmide___file_and_name ; Parameter: $fmide___script_parameter ; Wait for completion: On ]
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

