Set Variable [ $fmide___script_step_search[1] ; Value: Case (
not IsEmpty ( $fmide___script_step_search )  ; $fmide___script_step_search ;
not IsEmpty ( $fmide___script_step_search_value ) ; Evaluate( $fmide___script_step_search_value )
) ]
Else If [ $fmide__action_name = "FindScript" or not IsEmpty ( $fmide___script_search ) or not IsEmpty ( $fmide___script_search_value ) ]
