# Parameters are evaluated individually from the array as they are passed

# Action
If [ IsEmpty ( $fmide___object_name ) ]
# Active WebViewer
Perform JavaScript in Web Viewer [ Object Name: <Active Object> ; Function Name: $function_name ; Parameter 1: Evaluate ( JSONGetElement ( $fmide___parameter ; "[0]" ) ) ; Parameter 2: Evaluate ( JSONGetElement ( $fmide___parameter ; "[1]" ) ) ; Parameter 3: Evaluate ( JSONGetElement ( $fmide___parameter ; "[2]" ) ) ; Parameter 4: Evaluate ( JSONGetElement ( $fmide___parameter ; "[3]" ) ) ; Parameter 5: Evaluate ( JSONGetElement ( $fmide___parameter ; "[4]" ) ) ; Parameter 6: Evaluate ( JSONGetElement ( $fmide___parameter ; "[5]" ) ) ; Parameter 7: Evaluate ( JSONGetElement ( $fmide___parameter ; "[6]" ) ) ; Parameter 8: Evaluate ( JSONGetElement ( $fmide___parameter ; "[7]" ) ) ; Parameter 9: Evaluate ( JSONGetElement ( $fmide___parameter ; "[8]" ) ) ; Parameter 10: Evaluate ( JSONGetElement ( $fmide___parameter ; "[9]" ) ) ; Parameter 11: Evaluate ( JSONGetElement ( $fmide___parameter ; "[10]" ) ) ; Parameter 12: Evaluate ( JSONGetElement ( $fmide___parameter ; "[11]" ) ) ; Parameter 13: Evaluate ( JSONGetElement ( $fmide___parameter ; "[12]" ) ) ; Parameter 14: Evaluate ( JSONGetElement ( $fmide___parameter ; "[13]" ) ) ; Parameter 15: Evaluate ( JSONGetElement ( $fmide___parameter ; "[14]" ) ) ; Parameter 16: Evaluate ( JSONGetElement ( $fmide___parameter ; "[15]" ) ) ; Parameter 17: Evaluate ( JSONGetElement ( $fmide___parameter ; "[16]" ) ) ; Parameter 18: Evaluate ( JSONGetElement ( $fmide___parameter ; "[17]" ) ) ; Parameter 19: Evaluate ( JSONGetElement ( $fmide___parameter ; "[18]" ) ) ; Parameter 20: Evaluate ( JSONGetElement ( $fmide___parameter ; "[19]" ) ) ]
Else
# Named WebViewer
Perform JavaScript in Web Viewer [ Object Name: $fmide___object_name ; Function Name: $fmide___function_name ; Parameter 1: Evaluate ( JSONGetElement ( $fmide___parameter ; "[0]" ) ) ; Parameter 2: Evaluate ( JSONGetElement ( $fmide___parameter ; "[1]" ) ) ; Parameter 3: Evaluate ( JSONGetElement ( $fmide___parameter ; "[2]" ) ) ; Parameter 4: Evaluate ( JSONGetElement ( $fmide___parameter ; "[3]" ) ) ; Parameter 5: Evaluate ( JSONGetElement ( $fmide___parameter ; "[4]" ) ) ; Parameter 6: Evaluate ( JSONGetElement ( $fmide___parameter ; "[5]" ) ) ; Parameter 7: Evaluate ( JSONGetElement ( $fmide___parameter ; "[6]" ) ) ; Parameter 8: Evaluate ( JSONGetElement ( $fmide___parameter ; "[7]" ) ) ; Parameter 9: Evaluate ( JSONGetElement ( $fmide___parameter ; "[8]" ) ) ; Parameter 10: Evaluate ( JSONGetElement ( $fmide___parameter ; "[9]" ) ) ; Parameter 11: Evaluate ( JSONGetElement ( $fmide___parameter ; "[10]" ) ) ; Parameter 12: Evaluate ( JSONGetElement ( $fmide___parameter ; "[11]" ) ) ; Parameter 13: Evaluate ( JSONGetElement ( $fmide___parameter ; "[12]" ) ) ; Parameter 14: Evaluate ( JSONGetElement ( $fmide___parameter ; "[13]" ) ) ; Parameter 15: Evaluate ( JSONGetElement ( $fmide___parameter ; "[14]" ) ) ; Parameter 16: Evaluate ( JSONGetElement ( $fmide___parameter ; "[15]" ) ) ; Parameter 17: Evaluate ( JSONGetElement ( $fmide___parameter ; "[16]" ) ) ; Parameter 18: Evaluate ( JSONGetElement ( $fmide___parameter ; "[17]" ) ) ; Parameter 19: Evaluate ( JSONGetElement ( $fmide___parameter ; "[18]" ) ) ; Parameter 20: Evaluate ( JSONGetElement ( $fmide___parameter ; "[19]" ) ) ]
End If
