Else If [ $fmide__action_name = "SaveACopyAsXml" or $fmide__action_name = "SaveAsXml" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#save-a-copy-as-xml

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "file_path" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___file_path[1] ; Value: JSONGetElement ( $fmide_action ; "file_path" ) ]
Set Variable [ $fmide___window_name[1] ; Value: JSONGetElement ( $fmide_action ; "window_name" ) ]
# either
Set Variable [ $fmide___include_details[1] ; Value: JSONGetElement ( $fmide_action ; "include_details" ) ]
Set Variable [ $fmide___standalone_binarydata[1] ; Value: JSONGetElement ( $fmide_action ; "standalone_binarydata" ) ]
# or
Set Variable [ $fmide___json_options[1] ; Value: JSONGetElement ( $fmide_action ; "json_options" ) ]
# LOL - so bad:
#> JSONSetElement ( "{}" ;
#>   [ "catalogs_included" ; JSONMakeArray (
#>   "PersistentStoreCatalog
#>   BaseDirectoryCatalog
#>   FileAccessCatalog
#>   ExternalDataSourceCatalog
#>   BaseTableCatalog
#>   TableOccurrenceCatalog
#>   CustomFunctionsCatalog
#>   ValueListCatalog
#>   FieldCatalog
#>   RelationshipCatalog
#>   CustomMenuCatalog
#>   CustomMenuSetCatalog
#>   ScriptCatalog
#>   ThemeCatalog
#>   LayoutCatalog
#>   LibraryCatalog
#>   PrivilegeSetsCatalog
#>   ExtendedPrivilegesCatalog
#>   AccountsCatalog
#>   Metadata"
#>   ; " " ; JSONString ) ; JSONArray ] ;
#>   [ "include_details" ; False ; JSONBoolean ] ;
#>   [ "split_catalogs" ; False ; JSONBoolean ] ;
#>   [ "standalone_binarydata" ; False ; JSONBoolean ]
#> )

# Calculations
Set Variable [ $fmide___window_name[1] ; Value: Evaluate ( $fmide___window_name ) ]
Set Variable [ $fmide___file_path[1] ; Value: Evaluate ( $fmide___file_path ) ]
# either
Set Variable [ $fmide___include_details[1] ; Value: Evaluate ( $fmide___include_details ) ]
Set Variable [ $fmide___standalone_binarydata[1] ; Value: Evaluate ( $fmide___standalone_binarydata ) ]
# or
Set Variable [ $fmide___json_options[1] ; Value: Case( Left( $fmide___json_options ; 1 ) = "{" ; $fmide___json_options ; Evaluate ( $fmide___json_options ) ) ]

# Defaults
# None

# Action
If [ $fmide__fm_version_major ≥ 26 ]
# FM26+
If [ not IsEmpty ( $fmide___json_options ) ]
Save a Copy as XML [ Window name: $fmide___window_name ; Destination file: “$fmide___file_path” ; Specify options as JSON: $fmide___json_options ]
Else
If [ $fmide___include_details ]
If [ $fmide___standalone_binarydata ]
# with details, with standalone binarydata
Save a Copy as XML [ Window name: $fmide___window_name ; Destination file: “$fmide___file_path” ; Include details for analysis tools ; Save each layout object's binary data under its node ]
Else
# with details, no standalone binarydata
Save a Copy as XML [ Window name: $fmide___window_name ; Destination file: “$fmide___file_path” ; Include details for analysis tools ]
End If
Else
If [ $fmide___standalone_binarydata ]
# no details, with standalone binarydata
Save a Copy as XML [ Window name: $fmide___window_name ; Destination file: “$fmide___file_path” ; Save each layout object's binary data under its node ]
Else
# no details, no standalone binarydata
Save a Copy as XML [ Window name: $fmide___window_name ; Destination file: “$fmide___file_path” ]
End If
End If
End If
Else
# Legacy code < FM26
Save a Copy as XML [ Window name: $fmide___window_name ; Destination file: “$fmide___file_path” ]
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Reset Vars
Set Variable [ $fmide___file_path[1] ; Value: "" ]
Set Variable [ $fmide___include_details[1] ; Value: "" ]
Set Variable [ $fmide___json_options[1] ; Value: "" ]
Set Variable [ $fmide___standalone_binarydata[1] ; Value: "" ]
Set Variable [ $fmide___window_name[1] ; Value: "" ]


Else If [ $fmide__action_name = "SelectAll" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#select-all

# Action
Select All
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]


Else If [ $fmide__action_name = "SelectWindow" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#select-window

# Process Short Form
If [ $fmide__action_element_type = JSONNull or $fmide__action_element_type = JSONObject and IsEmpty ( JSONListKeys ( $fmide_action ; "" ) ) ]
# Select Window (null/{}) -> Select Window «original window»
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "window_name" ; Quote( $fmide__original_window_name ) ; JSONString ) ]
Else If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "window_name" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___window_name[1] ; Value: JSONGetElement ( $fmide_action ; "window_name" ) ]
Set Variable [ $fmide___current_file[1] ; Value: JSONGetElement ( $fmide_action ; "current_file" ) ]

# Calculations
Set Variable [ $fmide___window_name[1] ; Value: Evaluate ( $fmide___window_name ) ]
Set Variable [ $fmide___current_file[1] ; Value: Evaluate ( $fmide___current_file ) ]

# Action
If [ IsEmpty ( $fmide___window_name ) ]
Select Window [ Current Window ]
Else If [ $fmide___current_file ]
Select Window [ Name: $fmide___window_name; Current file ]
Else
Select Window [ Name: $fmide___window_name ]
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Case ( Get ( LastError ) = 112 ; "Window '" & $fmide___window_name  & "' is missing" ;  Get ( LastErrorDetail ) ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Recalculate the uuid of the current window
Set Variable [ $fmide__current_window_uuid[1] ; Value: Let(
[
¢window_id = Evaluate ( "Get ( WindowUUID )" ) ;
¢window_id = Case( ¢window_id ≠ "?" ; ¢window_id ; MBS( "Window.Current") )
];
¢window_id
) ]

# Reset Vars
Set Variable [ $fmide___current_file[1] ; Value: "" ]
Set Variable [ $fmide___window_name[1] ; Value: "" ]


Else If [ $fmide__action_name = "Set" or $fmide__action_name = "SetVariable" or $fmide__action_name = "SetField" or $fmide__action_name = "SetFieldByName" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#set
# [+].Set.$var = 1+2
# [+].Set
#> [:]..target = "$var"
#> [:]..calculation = 1+2
# [+].Set.$var".calculation = 1+2

# Process Short Form (target)
If [ $fmide__action_element_type ≠ JSONObject ]
# Error: No target name
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = "Action is invalid: Expected JSONObject."  ;
$fmide__error_thrown = 1

];

5

) ]
Else

# Params
Set Variable [ $fmide___target[1] ; Value: Case(
not IsEmpty ( JSONGetElement ( $fmide_action ; "target" ) ) ; JSONGetElement ( $fmide_action ; "target" ) ;
not IsEmpty ( JSONGetElement ( $fmide_action ; "name" ) ) ; JSONGetElement ( $fmide_action ; "name" ) ;
not IsEmpty ( JSONGetElement ( $fmide_action ; "field_name" ) ) ; JSONGetElement ( $fmide_action ; "field_name" ) ;
not IsEmpty ( JSONGetElement ( $fmide_action ; "variable_name" ) ) ; JSONGetElement ( $fmide_action ; "variable_name" )
) ]

# Process Short Form
If [ IsEmpty ( $fmide___target ) ]
# Process .«target.possibly.with.dots»…
Set Variable [ $fmide___not_parameter_names[1] ; Value: "calculation" ]
Loop [ Flush type: Always ]
Set Variable [ $fmide___key[1] ; Value: JSONListKeys ( $fmide_action ; "" ) ]
If [ ValueCount( $fmide___key ) = 1 and IsEmpty ( FilterValues ( $fmide___not_parameter_names ; $fmide___key ) ) ]
# Extract target
Set Variable [ $fmide__action_element_type[1] ; Value: JSONGetElementType ( $fmide_action ; $fmide___key  ) ]
Set Variable [ $fmide_action[1] ; Value: JSONGetElement ( $fmide_action ; $fmide___key  ) ]
# Concatenate target key parts with a dot…
Set Variable [ $fmide___target[1] ; Value: $fmide___target & Case( not IsEmpty ( $fmide___target ) ; "." ) & $fmide___key ]
Else
# End of the line…
If [ IsEmpty ( $fmide___target ) ]
# Error: No target
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = "Action is invalid: Expected single «target» but found multiple elements."  ;
$fmide__error_thrown = 1

];

5

) ]
End If
Exit Loop If [ 1 ]
End If
End Loop
End If

# Process Short Form
If [ $fmide__action_element_type = JSONArray ]
# JsonArray -> repetition number
Set Variable [ $fmide___repetition[1] ; Value: ValueCount ( JSONListKeys ( $fmide_action ; "" ) ) - 1 ]
Set Variable [ $fmide__action_element_type[1] ; Value: JSONGetElementType ( $fmide_action ; "[" & $fmide___repetition & "]"  ) ]
Set Variable [ $fmide_action[1] ; Value: JSONGetElement ( $fmide_action ; "[" & $fmide___repetition & "]"  ) ]
End If
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "calculation" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___calculation[1] ; Value: JSONGetElement ( $fmide_action ; "calculation" ) ]
If [ IsEmpty ( $fmide___repetition ) ]
Set Variable [ $fmide___repetition[1] ; Value: JSONGetElement ( $fmide_action ; "repetition" ) ]
End If

# Evaluate repetition to get get Target name
Set Variable [ $fmide___target[1] ; Value: $fmide___target & Case ( not IsEmpty ( $fmide___repetition ) ; "[" & Evaluate ( $fmide___repetition ) & "]" ) ]

# Calculations
If [ $fmide__action_name = "SetFieldByName" ]
# Set Field by Name -> evaluate the target
Set Variable [ $fmide___target[1] ; Value: Evaluate ( $fmide___target ) ]
End If
# Are evaluated below

# Action
# Set the variable in the condition…
If [ Case(
/* Case 0: Error ### */
Position( $fmide___target ; "$fmide__" ; 1 ; 1 ) ; Let([

  $$fmide_get_last_error = 1300 ;
  $$fmide_get_last_error_detail = "fmIDE error: The specified variable name '$fmide__*' is reserved for fmiIDE internal variables and may not be targeted in action " & $fmide__action_name ;
  $fmide__error_thrown = 1

  ];
  False
  ) ;



/* Case 1: Error 5 target missing */
IsEmpty ( $fmide___target ) ; Let([

  $$fmide_get_last_error = Case( $fmide__action_name = "SetVariable" ; 5 ; 102 ) ;
  $$fmide_get_last_error_thrown = 1 ;
  $$fmide_get_last_error_detail = "fmIDE error: missing target in action " & $fmide__action_name

  ];
  False
  ) ;

/* Case 2: Set Field table::field **/
Left( $fmide___target ; 1 ) ≠ "$" ; 
  True ; 

/* Case 3: Set Variable $fmide___target **/
Let(
[

vDefineVar = Evaluate( "Let([" & 
  /* Define the var */
  $fmide___target & "=" & $fmide___calculation  & 
  /* Log the variable name */
  "¶;$fmide__local_variables = List ( $fmide__local_variables ; Case( Position ( \¶ & $fmide__local_variables & \¶ ; \¶ & $fmide___target & \¶ ; 1 ; 1 ) = 0 ; $fmide___target ) ) " &
  "¶];0)"
);

$$fmide_get_last_error        = 0 ;
$$fmide_get_last_error_thrown = "" ;
$$fmide_get_last_error_detail = ""

];

False

)

) ]

# …otherwise set the target field
Set Field By Name [ $fmide___target ; Evaluate ( $fmide___calculation ) ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
End If
End If

# Reset Vars
Set Variable [ $fmide___calculation[1] ; Value: "" ]
Set Variable [ $fmide___i[1] ; Value: "" ]
Set Variable [ $fmide___key[1] ; Value: "" ]
Set Variable [ $fmide___keys[1] ; Value: "" ]
Set Variable [ $fmide___n[1] ; Value: "" ]
Set Variable [ $fmide___repetition[1] ; Value: "" ]
Set Variable [ $fmide___target[1] ; Value: "" ]


Else If [ $fmide__action_name = "SetClipboardObjects" or $fmide__action_name = "SetFileMakerData" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#set-clipboard-objects
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#set-filemaker-data

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "text" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___text[1] ; Value: JSONGetElement ( $fmide_action ; "text" ) ]
Set Variable [ $fmide___type[1] ; Value: JSONGetElement ( $fmide_action ; "type" ) ]

# Calculations
Set Variable [ $fmide___text[1] ; Value: Evaluate ( $fmide___text ) ]
Set Variable [ $fmide___type[1] ; Value: Evaluate ( $fmide___type ) ]

# Defaults
Set Variable [ $fmide___type[1] ; Value: Case( not IsEmpty ( $fmide___type ) ; $fmide___type ; "auto" ) ]

# Action
Set Variable [ $fmide___r[1] ; Value: MBS( "Clipboard.SetFileMakerData" ; $fmide___type ; $fmide___text ) ]

# Reset Vars
Set Variable [ $fmide___r[1] ; Value: "" ]
Set Variable [ $fmide___text[1] ; Value: "" ]
Set Variable [ $fmide___type[1] ; Value: "" ]


Else If [ $fmide__action_name = "SetClipboardText" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#set-clipboard-text

# Process Short Form
If [ $fmide__action_element_type ≤ JSONNumber ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "text" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___text[1] ; Value: JSONGetElement ( $fmide_action ; "text" ) ]
Set Variable [ $fmide___type[1] ; Value: JSONGetElement ( $fmide_action ; "type" ) ]

# Action
Set Variable [ $fmide___r[1] ; Value: Case ( 

not IsEmpty ( $fmide___type ) ; 
MBS( "Clipboard.SetText" ; Evaluate ( $fmide___text ) ; Evaluate ( $fmide___type ) ) ;
MBS( "Clipboard.SetText" ; Evaluate ( $fmide___text ) )
) ]

# Reset Vars
Set Variable [ $fmide___r[1] ; Value: "" ]
Set Variable [ $fmide___text[1] ; Value: "" ]
Set Variable [ $fmide___type[1] ; Value: "" ]


Else If [ $fmide__action_name = "SetDataFilePosition" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#set-data-file-position

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "position" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___file_id[1] ; Value: JSONGetElement ( $fmide_action ; "file_id" ) ]
Set Variable [ $fmide___position[1] ; Value: JSONGetElement ( $fmide_action ; "position" ) ]

# Calculations
Set Variable [ $fmide___file_id[1] ; Value: Evaluate ( $fmide___file_id ) ]
Set Variable [ $fmide___position[1] ; Value: Evaluate ( $fmide___position ) ]

# Defaults
If [ IsEmpty ( $fmide___file_id ) ]
# Default to last file opened
Set Variable [ $fmide___file_id[1] ; Value: LeftWords ( RightValues ( Get ( OpenDataFileInfo ) ; 1 ) ; 1 ) ]
End If

# Action
Set Data File Position [ File ID: $fmide___file_id ; New position: $fmide___position ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Reset Vars
Set Variable [ $fmide___file_id[1] ; Value: "" ]
Set Variable [ $fmide___position[1] ; Value: "" ]


Else If [ $fmide__action_name = "SetErrorCapture" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#set-error-capture

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "state" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___state[1] ; Value: JSONGetElement ( $fmide_action ; "state" ) ]

# Calculations
Set Variable [ $fmide___state[1] ; Value: Evaluate ( $fmide___state ) ]

# Action
Set Variable [ $$fmide_get_error_capture_state[1] ; Value: GetAsBoolean ( $fmide___state ) ]

# Reset Vars
Set Variable [ $fmide___state[1] ; Value: "" ]


Else If [ $fmide__action_name = "SetErrorLogging" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#set-error-logging

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "state" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___state[1] ; Value: JSONGetElement ( $fmide_action ; "state" ) ]
Set Variable [ $fmide___custom_debug_info[1] ; Value: JSONGetElement ( $fmide_action ; "custom_debug_info" ) ]

# Calculations
Set Variable [ $fmide___state[1] ; Value: Evaluate ( $fmide___state ) ]
# Note: $fmide___custom_debug_info DOES contain a calculation, but this is not evaluated here,
#> rather the calculation is stored into global variable `$$fmide__custom_debug_info`
#> and evaluated by the Set Error Logging step each time it is called

# Output fmIDE global (file) variable
Set Variable [ $$fmide__custom_debug_info[1] ; Value: $fmide___custom_debug_info ]

# Action
If [ $fmide___state ]
Set Error Logging [ On ; Custom debug info: Evaluate( $$fmide__custom_debug_info ) ]
Else
Set Error Logging [ Off ]
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Reset Vars
Set Variable [ $fmide___custom_debug_info[1] ; Value: "" ]
Set Variable [ $fmide___state[1] ; Value: "" ]


Else If [ $fmide__action_name = "SetSelection" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#set-selection

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "selection" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___selection[1] ; Value: JSONGetElement ( $fmide_action ; "selection" ) ]
Set Variable [ $fmide___start[1] ; Value: JSONGetElement ( $fmide_action ; "start" ) ]
Set Variable [ $fmide___end[1] ; Value: JSONGetElement ( $fmide_action ; "end" ) ]

# Calculations
Set Variable [ $fmide___selection[1] ; Value: Evaluate ( $fmide___selection ) ]
Set Variable [ $fmide___selection_values[1] ; Value: Case( not IsEmpty ( $fmide___selection ) ; Substitute ( $fmide___selection ; ["…" ; ¶] ; ["..." ; ¶] ; [".." ; ¶] ; ["-" ; ¶] ) ) ]
Set Variable [ $fmide___start[1] ; Value: Case(
not IsEmpty ( $fmide___start ) ; Evaluate ( $fmide___start ) ;
not IsEmpty ( $fmide___selection_values ) ; GetValue ( $fmide___selection_values ; 1 ) ;
) ]
Set Variable [ $fmide___end[1] ; Value: Case(
not IsEmpty ( $fmide___end ) ; Evaluate ( $fmide___end ) ;
not IsEmpty ( $fmide___selection_values ) ; GetValue ( $fmide___selection_values ; 2 ) ;
) ]

# Action
Set Selection [ Start Position: $fmide___start ; End Position: $fmide___end ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Reset Vars
Set Variable [ $fmide___end[1] ; Value: "" ]
Set Variable [ $fmide___selection[1] ; Value: "" ]
Set Variable [ $fmide___selection_values[1] ; Value: "" ]
Set Variable [ $fmide___start[1] ; Value: "" ]


Else If [ $fmide__action_name = "SetWindowTitle" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#set-window_title

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
# rename current window
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}"
;["new_window_title" ; $fmide_action ; $fmide__action_element_type]
;["current_window" ; True ; JSONBoolean]
) ]
End If

# Params
Set Variable [ $fmide___current_file[1] ; Value: JSONGetElement ( $fmide_action ; "current_file" ) ]
Set Variable [ $fmide___current_window[1] ; Value: JSONGetElement ( $fmide_action ; "current_window" ) ]
Set Variable [ $fmide___new_window_title[1] ; Value: JSONGetElement ( $fmide_action ; "new_window_title" ) ]
Set Variable [ $fmide___window_name[1] ; Value: JSONGetElement ( $fmide_action ; "window_name" ) ]
Set Variable [ $fmide___window_uuid[1] ; Value: JSONGetElement ( $fmide_action ; "window_uuid" ) ]


# Calculations
Set Variable [ $fmide___current_file[1] ; Value: Evaluate ( $fmide___current_file ) ]
Set Variable [ $fmide___current_window[1] ; Value: Evaluate ( $fmide___current_window ) ]
Set Variable [ $fmide___new_window_title[1] ; Value: Evaluate ( $fmide___new_window_title ) ]
Set Variable [ $fmide___window_name[1] ; Value: Evaluate ( $fmide___window_name ) ]
Set Variable [ $fmide___window_uuid[1] ; Value: Evaluate ( $fmide___window_uuid ) ]

# Defaults
Set Variable [ $fmide___window_identifier[1] ; Value: Case ( not IsEmpty ( $fmide___window_uuid ) ; $fmide___window_uuid ; $fmide___window_name ) ]

# Action
If [ $fmide___current_window ]
# Rename current window
Set Window Title [ Current Window; New Title: $fmide___new_window_title ]

Else If [ $fmide___current_file ]
# Rename window in current file
Set Window Title [ Of Window: $fmide___window_identifier; Current file; New Title: $fmide___new_window_title ]

Else
# Rename window in other file
Set Window Title [ Of Window: $fmide___window_identifier; New Title: $fmide___new_window_title ]

End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Reset Vars
Set Variable [ $fmide___current_file[1] ; Value: "" ]
Set Variable [ $fmide___current_window[1] ; Value: "" ]
Set Variable [ $fmide___new_window_title[1] ; Value: "" ]
Set Variable [ $fmide___window_name[1] ; Value: "" ]
Set Variable [ $fmide___window_uuid[1] ; Value: "" ]


