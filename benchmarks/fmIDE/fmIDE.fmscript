Set Variable [ $fmide___macro[1] ; Value: "" ]
Set Variable [ $fmide___macro_name[1] ; Value: "" ]
Set Variable [ $fmide___target[1] ; Value: "" ]


Else If [ $fmide__action_name = "FmideRunMacro" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#fmide-run-macro


# Process Short Form
Set Variable [ $fmide___action_keys[1] ; Value: JSONListKeys ( $fmide_action ; "" ) ]
If [ $fmide__action_element_type = JSONString ]
# fmIDE Run Macro = «string»
#> ->
#> fmIDE Run Macro.macro_name = «string»
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}"
;["macro_name" ; $fmide_action ; JSONString]
) ]
Else If [ $fmide__action_element_type = JSONObject and ValueCount ( $fmide___action_keys ) = 1 and $fmide___action_keys ≠ "macro_name" ]
# fmIDE Run Macro.«macro_name» = «string»
#> -> 
#> fmIDE Run Macro
#> .macro_name = «macro_name»
#> .frontmatter = «string»
# FIXME - if macro names are evaluated this must be quoted
Set Variable [ $fmide___macro_name[1] ; Value: $fmide___action_keys ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}"
;["frontmatter" ; JSONGetElement ( $fmide_action ; $fmide___macro_name ) ; JSONString]
;["macro_name" ; $fmide___macro_name ; JSONString]
) ]
End If

# Params
# [+].FmideRunMacro
#> [:]..macro_name
#> [:]..frontmatter
Set Variable [ $fmide___macro_name[1] ; Value: JSONGetElement ( $fmide_action ; "macro_name" ) ]
Set Variable [ $fmide___frontmatter[1] ; Value: JSONGetElement ( $fmide_action ; "frontmatter" ) ]

# Calculations
# FIXME - macro names SHOULD be evaluated
// Set Variable [ $fmide___macro_name[1] ; Value: Evaluate ( $fmide___macro_name ) ]
Set Variable [ $fmide___frontmatter[1] ; Value: Evaluate ( $fmide___frontmatter ) ]

# Action
Set Variable [ $fmide___macro[1] ; Value: GetPersistentData ( "fmide_macros" ; $fmide___macro_name ) ]
If [ $fmide___macro = "?" ]
# macro is missing
# Error 1700, Resource doesn't exist, is a good error for this
Set Variable [ $$fmide_get_last_error[1] ; Value: 1700 /* Resource doesn't exist */ ]
Set Variable [ $$fmide_get_last_error_detail[1] ; Value: Substitute ( "fmide macro '{1}' not found" ; "{1}" ; $fmide___macro_name ) ]
Set Variable [ $fmide__error_thrown[1] ; Value: 1 ]
Else
# Extract the macro code
Set Variable [ $fmide___macro_code[1] ; Value: JSONGetElement ( $fmide___macro ;  "code" ) ]

# Pass inputs to the macro
Set Variable [ $fmide___parameter[1] ; Value: Case(

/* Case 0: No frontmatter */
IsEmpty ( $fmide___frontmatter ) ;
  $fmide___macro_code ;

/* Case 1: Add frontmatter before code */
Left( $fmide___macro_code ; 4 ) ≠ "---¶" ; 

  List(
  "---" ; 
  $fmide___frontmatter ;
  "---" ;
  $fmide___macro_code
  ) ;

/* Otherwise Case 2: Merge frontmatter */
  Replace ( $fmide___macro_code ; 4 ; 0 ; $fmide___frontmatter /* FIXME - handle trailing semicolon */)

) ]

Perform Script [ Specified: By name ; "fmIDE" ; Parameter: $fmide___parameter ]
End If

# Reset Vars
Set Variable [ $fmide___action_keys[1] ; Value: "" ]
Set Variable [ $fmide___frontmatter[1] ; Value: "" ]
Set Variable [ $fmide___macro[1] ; Value: "" ]
Set Variable [ $fmide___macro_code[1] ; Value: "" ]
Set Variable [ $fmide___macro_name[1] ; Value: "" ]
Set Variable [ $fmide___parameter[1] ; Value: "" ]


