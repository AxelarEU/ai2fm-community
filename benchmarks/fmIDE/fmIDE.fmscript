# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#perform-find

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "query" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___query[1] ; Value: JSONGetElement ( $fmide_action ; "query" ) ]

# TRY
Loop [ Flush type: Defer ]
If [ $fmide__action_name = "ShowAllRecords" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#show-all-records

# Action
Show All Records
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
Else
If [ not IsEmpty ( $fmide___query ) ]
# Query

# Action
Enter Find Mode [ Pause: Off ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
Exit Loop If [ $$fmide_get_last_error ]

# Get query criteria and convert to Array if necessary
Set Variable [ $fmide___request_array[1] ; Value: Case(
JSONGetElementType ( $fmide___query ; "request" ) ≠ JSONArray ; 
"[" & JSONGetElement ( $fmide___query ; "request" ) & "]" ;

JSONGetElement ( $fmide___query ; "request" )
) ]
Set Variable [ $fmide___request_index[1] ; Value: 0 ]
Set Variable [ $fmide___request_count[1] ; Value: ValueCount ( JSONListKeys ( $fmide___request_array ; "" ) ) ]
# FOR EACH request
Loop [ Flush type: Always ]
Exit Loop If [ $fmide___request_index ≥ $fmide___request_count ]
Set Variable [ $fmide___request[1] ; Value: JSONGetElement ( $fmide___request_array ; $fmide___request_index ) ]

Set Variable [ $fmide___omit[1] ; Value: JSONGetElement ( $fmide___request ; "omit" ) ]
If [ $fmide___omit ]
Omit Record
End If

# FOR EACH criteria in the request
Set Variable [ $fmide___criteria_array[1] ; Value: Case(
JSONGetElementType ( $fmide___request ; "criteria" ) ≠ JSONArray ; 
"[" & JSONGetElement ( $fmide___request ; "criteria" ) & "]" ;

JSONGetElement ( $fmide___request ; "criteria" )
) ]
Set Variable [ $fmide___criteria_index[1] ; Value: 0 ]
Set Variable [ $fmide___criteria_count[1] ; Value: ValueCount ( JSONListKeys ( $fmide___criteria_array ; "" ) ) ]
Loop [ Flush type: Always ]
Exit Loop If [ $fmide___criteria_index ≥ $fmide___criteria_count ]
Set Variable [ $fmide___criteria[1] ; Value: JSONGetElement ( $fmide___criteria_array; "[" & $fmide___criteria_index & "]" ) ]

# Get field_name, value and operator
Set Variable [ $fmide___field_name[1] ; Value: JSONGetElement ( $fmide___criteria ; "field_name" ) ]
Set Variable [ $fmide___value[1] ; Value: JSONGetElement ( $fmide___criteria ; "value" ) ]
Set Variable [ $fmide___operator[1] ; Value: JSONGetElement ( $fmide___criteria ; "operator" ) ]

Set Variable [ $fmide___value[1] ; Value: Case (

/* no operator */
IsEmpty( $fmide___operator ) ; $fmide___value ;

/* *"" -> *"«value»", or "" -> "«value»" */
Right( $fmide___operator ; 1 ) = "\"" ; Replace ( $fmide___operator ; Length( $fmide___operator ) ; 0 ; $fmide___value ) ;

/* «operator»«value», e.g. ==Some Name or identifier */
$fmide___operator & $fmide___value

) ]

# Set criteria
Set Field By Name [ $fmide___field_name ; $fmide___value ]

# NEXT criteria
Set Variable [ $fmide___criteria_index[1] ; Value: $fmide___criteria_index+1 ]
End Loop

# NEXT request
Set Variable [ $fmide___request_index[1] ; Value: $fmide___request_index + 1 ]
Exit Loop If [ $fmide___request_index ≥ $fmide___request_count ]

# For each further request we need a New Record/Request
New Record/Request
End Loop
End If

If [ Get ( WindowMode ) = 1 /* 1 = Find mode */ ]
# FIND / CONSTRAIN / EXTEND
Set Variable [ $fmide___found_set[1] ; Value: Case (
$fmide__action_name = "ConstrainFoundSet" ; "constrain" ;
$fmide__action_name = "ExtendFoundSet" ; "extend" ;
JSONGetElement ( $fmide___query ; "found_set" )
) ]
If [ $fmide___found_set = "constrain" ]
# Constrain found_set
Constrain Found Set []
Else If [ $fmide___found_set = "extend" ]
# Extend found_set
Extend Found Set []
Else
# Replace found_set = find
Perform Find []

End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
End If
End If

# END TRY
Exit Loop If [ True ]
End Loop

# Reset Vars
Set Variable [ $fmide___criteria[1] ; Value: "" ]
Set Variable [ $fmide___criteria_array[1] ; Value: "" ]
Set Variable [ $fmide___criteria_count[1] ; Value: "" ]
Set Variable [ $fmide___criteria_index[1] ; Value: "" ]
Set Variable [ $fmide___field_name[1] ; Value: "" ]
Set Variable [ $fmide___found_set[1] ; Value: "" ]
Set Variable [ $fmide___omit[1] ; Value: "" ]
Set Variable [ $fmide___operator[1] ; Value: "" ]
Set Variable [ $fmide___query[1] ; Value: "" ]
Set Variable [ $fmide___request[1] ; Value: "" ]
Set Variable [ $fmide___request_array[1] ; Value: "" ]
Set Variable [ $fmide___request_count[1] ; Value: "" ]
Set Variable [ $fmide___request_index[1] ; Value: "" ]
Set Variable [ $fmide___text[1] ; Value: "" ]
Set Variable [ $fmide___value[1] ; Value: "" ]


Else If [ $fmide__action_name = "ShowOmittedOnly" ]
