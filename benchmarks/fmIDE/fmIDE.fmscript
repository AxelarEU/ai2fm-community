Set Variable [ $fmide___flush_cached_external_data[1] ; Value: Evaluate ( $fmide___flush_cached_external_data ) or $fmide___flush ]

# Action
If [ $fmide___flush_cached_join_results ]
If [ $fmide___flush_cached_external_data ]
Refresh Window [ Flush cached join results ; Flush cached external data ]
Else
Refresh Window [ Flush cached join results ]
End If
Else
If [ $fmide___flush_cached_external_data ]
Refresh Window [ Flush cached external data ]
Else
Refresh Window []
End If
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Reset Vars
