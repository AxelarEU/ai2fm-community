# [+].Exit Script = "\"finished\""
# [+].Exit Script = ===
#> "finished"
#> ===

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "script_result" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
# [+].Exit Script
#> [:]..script_result
# *NEVER* will I call it a text result!
Set Variable [ $fmide___script_result[1] ; Value: JSONGetElement ( $fmide_action ; "script_result" ) ]

# Calculations
Set Variable [ $fmide___script_result[1] ; Value: Evaluate( $fmide___script_result ) ]

# Action
If [ 0 ]
Else If [ not IsEmpty ( $fmide_exit_script_result_path ) ]
# FIXME
Else If [ not IsEmpty ( $fmide_callback_url ) ]
If [ $fmide_callback_verify_ssl_certificates ]
Insert from URL [ Select ; With dialog: Off ; Target: $fmide___callback_response ; Verify SSL Certificates ; cURL options: $fmide_callback_curl ]
Else
Insert from URL [ Select ; With dialog: Off ; Target: $fmide___callback_response ; cURL options: $fmide_callback_curl ]
End If
# FIXME - Handle callback errors?
End If

// Set Variable [ $$fmide_debug_script_result[1] ; Value: $fmide___script_result & ": " & $fmide___script_result ]
Exit Script [ Result: $fmide___script_result ]


