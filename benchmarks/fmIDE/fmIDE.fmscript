; ["[0].FindScriptStep.script_step_search" ; $script_step_name ; JSONString]
);

not IsEmpty ( $script_step_search ) ; JSONSetElement ( "[]" 
; ["[0].FindScriptStep.script_step_search" ; $script_step_search ; JSONString]
);

not IsEmpty ( $script_step_search_value ) ; JSONSetElement ( "[]" 
; ["[0].FindScriptStep.script_step_search_value" ; $script_step_search_value ; JSONString]
);

not IsEmpty ( $t_o_name ) ; JSONSetElement ( "[]" 
; ["[0].action_name" ; "Go To Table Occurrence" ; JSONString] 
; ["[0].t_o_name" ; $t_o_name ; JSONString] 
);

not IsEmpty ( $theme_name ) ; JSONSetElement ( "[]" 
; ["[0].Go To Theme.theme_name" ; $theme_name ; JSONString]
);

not IsEmpty ( $url ) ; JSONSetElement ( "[]" 
; ["[0].Open URL.url" ; $url ; JSONString]
; ["[0].Open URL.with_dialog" ; $with_dialog ; JSONString]
);

not IsEmpty ( $value_list_name ) ; JSONSetElement ( "[]" 
; ["[0].Go To Value List.value_list_name" ; $value_list_name ; JSONString]
);


not IsEmpty ( $window_name ) ; JSONSetElement ( "[]" 
; ["[0].Select Window.window_name" ; $window_name ; JSONString]
);

ValueCount( $fmide__jsp_keys ) = 1 ; JSONSetElement ( "[]" 
; ["[0]" ; JSONGetElement ( $fmide__jsp ; GetValue( $fmide__jsp_keys ; 1 ) ) ; JSONObject] 
; ["[0].action_name" ; GetValue( $fmide__jsp_keys ; 1 ) ; JSONString]
);


/* leave empty if no variables found */
) ]

End If


# # Build actions array
If [ IsEmpty ( $fmide_actions ) ]
# actions = empty
If [ not IsEmpty ( $fmide_action ) ]
# Pack single action in an array
Set Variable [ $fmide_actions[1] ; Value: JSONSetElement ( "[]" ; "[0]" ; $fmide_action ; JSONObject ) ]
Else
Set Variable [ $fmide_actions[1] ; Value: "[]" ]
End If
Else If [ Left ( $fmide_actions ; 1 ) = "[" ]
# actions = JSONArray
Else
# A text parameter has already been handled above by $fmide__jsp
# FIXME - Can this line be reached? When?
End If


# # Initialise the execution state

# Initialise stack (for If and Loop)
Set Variable [ $fmide__action_stack[1] ; Value: "[{}]" ]
Set Variable [ $fmide__action_stack_top[1] ; Value: "[0]" ]
Set Variable [ $fmide__action_block[1] ; Value: "" ]
Set Variable [ $fmide__action_skip[1] ; Value: "" ]

# Initialise programme counter
Set Variable [ $fmide__action_index[1] ; Value: 0 ]
Set Variable [ $fmide__action_index_max[1] ; Value: ValueCount( JSONListKeys ( $fmide_actions ; "" ) ) ]

# Local Vars
Set Variable [ $fmide__local_variables[1] ; Value: "" ]

# Original context
Set Variable [ $fmide__original_layout_number[1] ; Value: Get( LayoutNumber ) ]
Set Variable [ $fmide__original_window_name[1] ; Value: GetValue ( WindowNames ; 1 ) ]

Else
# # Continuation start: read the current execution state back from the continuation
If [ Get ( ActiveModifierKeys ) = 1+2+4+8+16 ]
Show Custom Dialog [ Title: "fmIDE Continuation"; Message: Get( ScriptParameter ); Default Button: "OK", Commit: "Yes"; Button 2: "Pause", Commit: "No" ]
If [ Get ( LastMessageChoice ) = 2 ]
Pause/Resume Script [ Indefinitely ]
End If
End If

// # Unnecessary - the schedules free themselves up automatically
// # First, free up the MBS Schedule used to trigger the continuation call
// Set Variable [ $fmide__r[1] ; Value: Let(
// [
// vSchedleRef = $$fmide__continuation_mbs_schedule_ref;
// $$fmide__continuation_mbs_schedule_ref = ""
// ];
// MBS( "Schedule.Release"; vSchedleRef )
// ) ]

# Actions
Set Variable [ $fmide_actions[1] ; Value: JSONGetElement ( $fmide__continuation ; "actions" ) ]

# Initialise stack (for If and Loop)
Set Variable [ $fmide__action_stack[1] ; Value: JSONGetElement ( $fmide__continuation ; "action_stack" ) ]
Set Variable [ $fmide__action_stack_top[1] ; Value: JSONGetElement ( $fmide__continuation ; "action_stack_top" ) ]
Set Variable [ $fmide__action_block[1] ; Value: JSONGetElement ( $fmide__continuation ; "action_block" ) ]
Set Variable [ $fmide__action_skip[1] ; Value: JSONGetElement ( $fmide__continuation ; "action_skip" ) ]
# Initialise programme counter
Set Variable [ $fmide__action_index[1] ; Value: JSONGetElement ( $fmide__continuation ; "action_index" ) ]
Set Variable [ $fmide__action_index_max[1] ; Value: JSONGetElement ( $fmide__continuation ; "action_index_max" ) ]

# Redefine local variables
Set Variable [ $fmide__local_variables[1] ; Value: JSONGetElement ( $fmide__continuation ; "fmide_local_variables" ) ]
Set Variable [ $fmide__local_variables[1] ; Value: While(
[

¢vars = $fmide__local_variables ;
¢i = 1;
¢n = ValueCount ( ¢vars )

]; ¢i <= ¢n ;[

¢var = Substitute( GetValue ( ¢vars ; ¢i ) ; "$" ; "" ) ;

¢expression = "
  Let([
  $" & ¢var & "=$$fmide_local_variable_" & ¢var & " ;
  $$fmide_local_variable_" & ¢var & "=\"\" ;
  r=0];\"\”)" ;
$$expression = ¢expression ;
/* Redfine the variable as a local variable */
¢ignore_errors = Evaluate ( ¢expression ) ;

¢i = ¢i + 1

];

""

) ]

# Original context
Set Variable [ $fmide__original_layout_number[1] ; Value: JSONGetElement ( $fmide__continuation ; "original_layout_number" ) ]
Set Variable [ $fmide__original_window_name[1] ; Value: JSONGetElement ( $fmide__continuation ; "original_window_name" ) ]

# Clear the continuation
Set Variable [ $fmide__continuation[1] ; Value: "" ]
End If

# # Vars defined at this point
#> 
#> ## Public Vars
#> 
#> `$fmide_version
#> `$fmide_dialog_title
#> `$fmide_actions
#> 
#> ## Private Vars
#> 
#> ### Parameter vars
#> 
#> - `$fmide__jsp`: JSON Script Parameter
#> - `$fmide__jsp_type`: The type of parameter format that `$fmide__jsp` has
#> - `$fmide__jsp_keys`: The list of keys that `$fmide__jsp` contains / or a JSON `?…` error
#> 
#> - `$fmide__parameter_names_all`: List of all possible parameter names
#> - `$fmide__parameter_names_found`: List of found parameters names
#> 
#> ### Environment vars
#> 
#> - `$fmide__is_mac`: 1 if on a mac
#> - `$fmide__is_mbs`: 1 if the MBS plugin is present
#> - `$fmide__is_win`: 1 if on windows
#> - `$fmide__mbs_remote_control_press_command_or_control_key`: The key for MBS to use when controlling the keyboard
#> - `$fmide__original_layout_number`: The number of the original layout for the `Go to Original Layout` action
#> - `$fmide__original_window_name`: The name of the original window for the `Go to Original Window` action
#> 
#> ### fmIDE Action Script Interpreter state
#> 
#> - `$fmide__action_index`: loop variable / index into the `$fmide_actions array / 'action pointer'
#> - `$fmide__action_index_max`:  loop variable / length of the `$fmide_actions array / 'action pointer' exclusive maximum value
#> - `$fmide__action_line`: FIXME: What is?
#> - `$fmide__action_block`: inside blocks = the name of the action that started the current block
#> 
#> - `$fmide__action_skip`: Defines what to skip:
#> 
#>   - `If`: Skip the current `If`/`Else If` section
#>   - `End If`: Skip to the next `End If` step, because an `If`/`ElseIf` section is completed
#>   - `{block}`:  Skip everything in the rest of the block, that is, until the stack is popped off
#> 
#> - `$fmide__action_stack`: The stack controlling the execution depth and logic
#> 
#>   - contains action_stack frame objects each having the following information
#> 
#>     - `block`: The name of the action that started the block
#>     - `index`: The action index identifying the line in the action array
#>     - `skip`: 1 = skip
#> 
#> - `$fmide__action_stack_top`: Pointer to the top of the action stack
#> - `$fmide__actions_string`: FIXME: What is?
#> 
#> - `$fmide__local_variables`: A list of variables defined with the `Set` action
#> 
#> 
#> - `$fmide__continuation`: 1 = hiatus + continuation
#> - `$fmide__continuation_seconds`: Number of seconds before the hiatus continues
#> 
#> ### Temporary variables
#> 
#> - `$fmide__i`: Loop variable
#> - `$fmide__n`: Loop variable length
#> - `$fmide__r`: (MBS) result variable




# ########################
# # Process actions array
# ########################





Loop [ Flush type: Always ]
Exit Loop If [ $fmide__action_index >= $fmide__action_index_max ]
# ## Process next action
Set Variable [ $fmide_action[1] ; Value: JSONGetElement ( $fmide_actions ; $fmide__action_index ) ]
Set Variable [ $fmide__action_element_type[1] ; Value: JSONGetElementType ( $fmide_actions ; $fmide__action_index ) ]
Set Variable [ $fmide__action_number[1] ; Value: $fmide__action_index+1 ]

If [ not IsEmpty ( $fmide_pause_on_condition ) and not IsEmpty ( $fmide_pause_on_condition_calculation ) ]
# Evaluate pause on condition calculation
Set Variable [ $fmide__pause_on_condition_value[1] ; Value: Evaluate ( $fmide_pause_on_condition_calculation ) ]
If [ not $fmide_debugger and $fmide__pause_on_condition_value ]
# true -> trigger debugger
Set Variable [ $fmide_debugger[1] ; Value: 1 ]
End If
End If

# # TRY (fmIDE error handling)
Loop [ Flush type: Always ]
Set Variable [ $fmide__skipped[1] ; Value: "" ]

If [ IsEmpty ( $fmide_action ) ]

# Skip null
Set Variable [ $fmide__skipped[1] ; Value: 1 ]

Else
# ## Process action_name
Set Variable [ $fmide__action_name[1] ; Value: JSONGetElement ( $fmide_action ; "action_name" ) ]
If [ Left( $fmide__action_name ; 1 ) = "?" ]
# JSON error - is handeled below
Else If [ not IsEmpty ( $fmide__action_name ) ]
# Syntax = action name is one of the action parameters
#> action.action_name
#> action.action_param1
#> action.action_param2
#> …
# use explicit action name
Else
# action name is json key
Set Variable [ $fmide__action_name[1] ; Value: JSONListKeys ( $fmide_action ; "" ) ]
If [ ValueCount ( $fmide__action_name ) = 1 ]
Set Variable [ $fmide__action_element_type[1] ; Value: JSONGetElementType ( $fmide_action ; $fmide__action_name ) ]
Set Variable [ $fmide_action[1] ; Value: JSONGetElement ( $fmide_action ; $fmide__action_name ) ]
Else
# FIXME Handle - action name has a ¶ in it
End If

End If

If [ $fmide_debugger ]
Show Custom Dialog [ Title: "fmIDE Debugger"; Message: Case( not IsEmpty ( $fmide__pause_on_condition_value ) ; "Pausing on condition: " & $fmide__pause_on_condition_value & ¶ ) & 
$fmide__action_number & "/" & $fmide__action_index_max & " " & Case( not IsEmpty ( $fmide__action_skip ) ; "(skip " & $fmide__action_skip & ") " ) & Quote ( $fmide__action_name ) & ¶ & 
$fmide_action; Default Button: "Continue", Commit: "Yes"; Button 2: "Pause", Commit: "No"; Button 3: "…", Commit: "No" ]
If [ Get ( LastMessageChoice ) = 1 ]
# 1. Continue
Else If [ Get ( LastMessageChoice ) = 2 ]
# 2. Pause
Pause/Resume Script [ Indefinitely ]
Else If [ Get ( LastMessageChoice ) = 3 ]
# 3. …
Show Custom Dialog [ Title: "fmIDE Debugger"; Message: "[" & $fmide__action_index & "]/" & $fmide__action_index_max & " " & Quote ( $fmide__action_name ) & ¶ & 
$fmide_action & "¶" & 
Case( $$fmide_get_last_error ; "Error: " & $$fmide_get_last_error ) &
Case( not IsEmpty ( $$fmide_get_last_error ) ; " (" & $$fmide_get_last_error_detail & ")" ); Default Button: "Debugger OFF", Commit: "Yes"; Button 2: "Continue", Commit: "No"; Button 3: "Halt", Commit: "No" ]
If [ Get ( LastMessageChoice ) = 1 ]
# 1. Debugger off
Set Variable [ $fmide_debugger[1] ; Value: "" ]
Else If [ Get ( LastMessageChoice ) = 2 ]
# 2. Continue
Else If [ Get ( LastMessageChoice ) = 3 ]
# 3. HALT
Halt Script
End If
End If
End If

# ## Convert action_name to UpperCamelCase, so that all these formats are supported:
# - Go to Layout (Natural)
# - go_to_layout (lower_snake_case)
# - gotolayout (onelowerwordcase)
# - GoToLayout (UpperCamelCase)
# - Go   to   layout (Unnatural spacing)
Set Variable [ $fmide__action_name[1] ; Value: Let(
[

vTemp = Substitute ( Proper( $fmide__action_name )
;[" " ; ""]
;[Char(9) ; ""]
;["_" ; ""]
;["-" ; ""]
)

];

/* Remove "/" chars from the action name whilst keeping the disabled marker `//` at the beginning of the line */
Case( Left ( vTemp ; 2 ) = "//" ; "//" ) & Substitute ( vTemp ; ["/" ; ""] )

) ]

# ## Action enable / disable
# An action is considered disabled if disable is true, or enable is (explicitly) false, or the action starts with //
Set Variable [ $fmide__enable[1] ; Value: JSONGetElement ( $fmide_action ; "enable" ) ]
Set Variable [ $fmide__enable[1] ; Value: Case ( Left( $fmide__enable ; 1 ) ≠ "?" ; $fmide__enable ) ]

Set Variable [ $fmide__disable[1] ; Value: JSONGetElement ( $fmide_action ; "disable" ) ]
Set Variable [ $fmide__disable[1] ; Value: Case (
Left( $fmide__action_name ; 2 ) = "//" ; 1 ;    /* Visually disabled in action name */ 
Left( $fmide__disable ; 1 ) ≠ "?" ; $fmide__disable ;  /* disabled via disable property set to true */ 
Exact( $fmide__enable ; 0 ) ; 1                 /* disabled via enable property set to false */ 
) ]

If [ 0 ]

# # Process disabled/missing/garbled actions

Else If [ $fmide__disable or Exact( $fmide__enable ; 0 ) ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#-/
# Disabled action => skip

Set Variable [ $fmide__skipped[1] ; Value: 1 ]

Else If [ IsEmpty ( $fmide__action_name ) ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#
# No action => skip

Set Variable [ $fmide__skipped[1] ; Value: 1 ]

Else If [ Left ( $fmide__action_name ; 1 ) = "?" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#?
# Mangled action => skip
Set Variable [ $fmide__skipped[1] ; Value: 1 ]

Else If [ $fmide__action_name = "#" or $fmide__action_name = "# (comment)" or Left ( $fmide__action_name ; 1 ) = "#" or $fmide__action_name = "Comment" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/##
# Comment => skip
Set Variable [ $fmide__skipped[1] ; Value: 1 ]


Else If [ $fmide__action_name = "If" or
$fmide__action_name = "ElseIf" or
$fmide__action_name = "Else" or
$fmide__action_name = "EndIf" or

$fmide__action_name = "Loop" or
$fmide__action_name = "ExitLoopIf" or
$fmide__action_name = "EndLoop" ]

# # Process control actions and Stack Logic

# - Manage skipping
# - Detect illegal block semantics
# - Push + Pop stack at start + end of blocks

# ## Process Stack
If [ 0 ]
# SWITCH

Else If [ $fmide__action_name = "If" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#if
# See https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#if
If [ not IsEmpty( $fmide__action_skip ) ]
# Skip this entire block
Set Variable [ $fmide__action_skip[1] ; Value: "{block}" ]
Set Variable [ $fmide__skipped[1] ; Value: 1 ]
Else
# Perform this step // If the calculation does not evaluate to true then skip the `If` section
Set Variable [ $fmide__action_test_success[1] ; Value: GetAsBoolean( Evaluate ( $fmide_action ) ) ]
Set Variable [ $fmide__action_skip[1] ; Value: Case( not $fmide__action_test_success ; "If" ) ]
# $fmide__action_skip REMAINS EMPTY IF THE IF-BLOCK IS TO BE RUN
End If
# Push action block onto stack
Set Variable [ $fmide__action_block[1] ; Value: $fmide__action_name ]
Set Variable [ $fmide__action_stack_top[1] ; Value: SerialIncrement ( $fmide__action_stack_top ; 1 ) ]
Set Variable [ $fmide__action_stack[1] ; Value: JSONSetElement ( $fmide__action_stack ; $fmide__action_stack_top ; 
JSONSetElement ( "{}" ; 
["block" ; $fmide__action_block ; JSONString];
["index" ; $fmide__action_index ; JSONNumber];
["skip" ; $fmide__action_skip ; JSONString]
) ; JSONObject ) ]

Else If [ $fmide__action_name = "ElseIf" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#else-if
If [ $fmide__action_block ≠ "If" ]
# Error / Bad Structure / Else If without If
Set Variable [ $$fmide_get_last_error[1] ; Value: 5 ]
Set Variable [ $$fmide_get_last_error_detail[1] ; Value: "Invalid fmIDE action script structure at action " & $fmide__action_number & ": " & $fmide__action_name ]
Set Variable [ $fmide__error_thrown[1] ; Value: 1 ]

Else If [ $fmide__action_skip = "{block}" ]
# Skip this entire block
Set Variable [ $fmide__skipped[1] ; Value: 1 ]
Else If [ $fmide__action_skip = "EndIf" ]
# Skip to EndIf
Set Variable [ $fmide__skipped[1] ; Value: 1 ]
Else
# Perform this step
If [ IsEmpty( $fmide__action_skip ) ]
# Empty -> previous (Else)If-part was run => skip to EndIf
Set Variable [ $fmide__action_skip[1] ; Value: "EndIf" ]
Else If [ $fmide__action_skip = "If" ]
# If-part was skipped => try this one
Set Variable [ $fmide__action_test_success[1] ; Value: GetAsBoolean( Evaluate ( $fmide_action ) ) ]
If [ $fmide__action_test_success ]
# Perform this section
Set Variable [ $fmide__action_skip[1] ; Value: "" ]
End If
End If
# Modify top stack block
Set Variable [ $fmide__action_stack[1] ; Value: JSONSetElement ( $fmide__action_stack ; $fmide__action_stack_top & ".skip" ; $fmide__action_skip ; JSONString ) ]
End If


Else If [ $fmide__action_name = "Else" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#else
If [ $fmide__action_block ≠ "If" ]
# Error / Bad Structure / Else If without If
# @todo

Else If [ $fmide__action_skip = "{block}" ]
# Skip this entire block
Set Variable [ $fmide__skipped[1] ; Value: 1 ]
Else If [ $fmide__action_skip = "EndIf" ]
# Skip to EndIf
Set Variable [ $fmide__skipped[1] ; Value: 1 ]
Else
# Perform this step
# If the If-part was skipped run the else part, otherwise skip to EndIf
Set Variable [ $fmide__action_skip[1] ; Value: Case( $fmide__action_skip = "If" ; "" ; "EndIf" ) ]
# Modify top stack block
Set Variable [ $fmide__action_stack[1] ; Value: JSONSetElement ( $fmide__action_stack ; $fmide__action_stack_top & ".skip" ; $fmide__action_skip ; JSONString ) ]
End If


Else If [ $fmide__action_name = "EndIf" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#end-if

If [ $fmide__action_block ≠ "If" ]
# Error / Bad Structure / End If without If
# @todo

Else
# Pop stack
Set Variable [ $fmide__action_stack[1] ; Value: JSONDeleteElement ( $fmide__action_stack ; $fmide__action_stack_top ) ]
Set Variable [ $fmide__action_stack_top[1] ; Value: SerialIncrement ( $fmide__action_stack_top ; -1 ) ]
Set Variable [ $fmide__action_block[1] ; Value: JSONGetElement ( $fmide__action_stack ; $fmide__action_stack_top & ".block" ) ]
# If ExitAfterLast is active, keep skipping, otherwise reinstate the previous skip-state outside of the if
Set Variable [ $fmide__action_skip[1] ; Value: Case ( $fmide__action_skip = "ExitAfterLast" ; $fmide__action_skip ; JSONGetElement ( $fmide__action_stack ; $fmide__action_stack_top & ".skip" ) ) ]

End If

Else If [ $fmide__action_name = "Loop" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#loop
# Push action block onto stack
Set Variable [ $fmide__action_skip[1] ; Value: Case( not IsEmpty( $fmide__action_skip ) ; "{block}" ) ]
Set Variable [ $fmide__action_block[1] ; Value: $fmide__action_name ]
Set Variable [ $fmide__action_stack_top[1] ; Value: SerialIncrement ( $fmide__action_stack_top ; 1 ) ]
Set Variable [ $fmide__action_stack[1] ; Value: JSONSetElement ( $fmide__action_stack ; $fmide__action_stack_top ; 
JSONSetElement ( "{}" ; 
["block" ; $fmide__action_block ; JSONString];
["index" ; $fmide__action_index ; JSONNumber];
["skip" ; $fmide__action_skip ; JSONString]
) ; JSONObject ) ]


Else If [ $fmide__action_name = "ExitLoopIf" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#exit-loop-if
If [ $fmide__action_block ≠ "Loop" ]
# Error / Bad Structure / ExitLoopIf without Loop
# @todo

Else If [ $fmide__action_skip = "{block}" ]
# Skip this entire block
Set Variable [ $fmide__skipped[1] ; Value: 1 ]
Else If [ $fmide__action_skip = "EndLoop" ]
# Skip to EndLoop
Set Variable [ $fmide__skipped[1] ; Value: 1 ]
Else
# Perform this step
If [ GetAsBoolean( Evaluate ( $fmide_action ) ) ]
# Exit loop!
Set Variable [ $fmide__action_skip[1] ; Value: $fmide__action_name ]
# Modify top stack block
Set Variable [ $fmide__action_stack[1] ; Value: JSONSetElement ( $fmide__action_stack ; $fmide__action_stack_top & ".skip" ; $fmide__action_skip ; JSONString ) ]
End If
End If


Else If [ $fmide__action_name = "EndLoop" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#end-loop
If [ $fmide__action_block ≠ "Loop" ]
# Error / Bad Structure / ExitLoopIf without Loop
# @todo
Else If [ IsEmpty ( $fmide__action_skip ) ]
# Loop back to action after the corresponding Loop step
Set Variable [ $fmide__action_index[1] ; Value: JSONGetElement ( $fmide__action_stack ; $fmide__action_stack_top & ".index" ) ]
Else
# Pop stack
Set Variable [ $fmide__action_stack[1] ; Value: JSONDeleteElement ( $fmide__action_stack ; $fmide__action_stack_top ) ]
Set Variable [ $fmide__action_stack_top[1] ; Value: SerialIncrement ( $fmide__action_stack_top ; -1 ) ]
Set Variable [ $fmide__action_block[1] ; Value: JSONGetElement ( $fmide__action_stack ; $fmide__action_stack_top & ".block" ) ]
Set Variable [ $fmide__action_skip[1] ; Value: JSONGetElement ( $fmide__action_stack ; $fmide__action_stack_top & ".skip" ) ]
End If

# END SWITCH
End If
# ## End Process Stack

Else If [ not IsEmpty ( $fmide__action_skip ) ]
# Skip all other steps
Set Variable [ $fmide__skipped[1] ; Value: 1 ]



Else
# # Process actions

If [ $fmide__action_element_type = JSONObject ]
// Set Variable []

End If


If [ 0 ]
# Action switch

Else If [ $fmide__action_name = "AdjustWindow" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#adjust-window

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "state" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___state[1] ; Value: JSONGetElement ( $fmide_action ; "state" ) ]

# Calculations
Set Variable [ $fmide___state[1] ; Value: Evaluate ( $fmide___state ) ]

# Action
If [ 0 ]
# Switch
Else If [ $fmide___state = "Resize to Fit" ]
Adjust Window [ Resize to Fit ]
Else If [ $fmide___state = "Maximize" ]
Adjust Window [ Maximize ]
Else If [ $fmide___state = "Minimize" ]
Adjust Window [ Minimize ]
Else If [ $fmide___state = "Restore" ]
Adjust Window [ Restore ]
Else If [ $fmide___state = "Hide" ]
Adjust Window [ Hide ]
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Reset vars
Set Variable [ $fmide___state[1] ; Value: "" ]

Else If [ $fmide__action_name = "AllowUserAbort" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#allow-user-abort

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "state" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___state[1] ; Value: JSONGetElement ( $fmide_action ; "state" ) ]

# Calculations
Set Variable [ $fmide___state[1] ; Value: Evaluate ( $fmide___state ) ]

# Action
Set Variable [ $$fmide_get_allow_abort_state[1] ; Value: GetAsBoolean ( $fmide___state ) ]
If [ $$fmide_get_allow_abort_state ]
Allow User Abort [ On ]
Else
Allow User Abort [ Off ]
End If

# Reset vars
Set Variable [ $fmide___state[1] ; Value: "" ]


Else If [ $fmide__action_name = "Beep" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#beep

# Action
Beep

Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]


