Set Variable [ $fmide___amount[1] ; Value: "" ]
Set Variable [ $fmide___file_id[1] ; Value: "" ]
Set Variable [ $fmide___read_as[1] ; Value: "" ]
Set Variable [ $fmide___target[1] ; Value: "" ]
Set Variable [ $fmide___target_temp[1] ; Value: "" ]


Else If [ $fmide__action_name = "RefreshWindow" ]
