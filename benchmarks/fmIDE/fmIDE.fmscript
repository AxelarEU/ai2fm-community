Else If [ $fmide__action_name = "Hiatus" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#hiatus

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "duration" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___indefinitely[1] ; Value: JSONGetElement ( $fmide_action ; "indefinitely" ) ]
Set Variable [ $fmide___duration[1] ; Value: Case ( 
not IsEmpty ( JSONGetElement ( $fmide_action ; "duration" ) ) ; JSONGetElement ( $fmide_action ; "duration" ) ; 
not IsEmpty ( JSONGetElement ( $fmide_action ; "s" ) ) ; JSONGetElement ( $fmide_action ; "s" ) ; 
not IsEmpty ( JSONGetElement ( $fmide_action ; "seconds" ) ) ; JSONGetElement ( $fmide_action ; "seconds" )
) ]

# Calculations
Set Variable [ $fmide___indefinitely[1] ; Value: Evaluate ( $fmide___indefinitely ) ]
Set Variable [ $fmide___duration[1] ; Value: Evaluate ( $fmide___duration ) ]

# Defaults
Set Variable [ $fmide___indefinitely[1] ; Value: $fmide___indefinitely or
$fmide___duration = "indefinitely" or
IsEmpty ( $fmide___duration ) ]


# Action
# Hiatus - Halt script for a moment
If [ $fmide___indefinitely ]
# ToDo - indefinite Hiatus needs a method for the user to exit the Hiatus and proceed with the continuation
# <thinking>
Halt Script
Else
# Request to halt and continue
Set Variable [ $fmide__continuation_halt_for_seconds[1] ; Value: $fmide___duration ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let( $$fmide_get_last_error_detail = "" ; 0 ) ]
End If

# Reset Vars
Set Variable [ $fmide___duration[1] ; Value: "" ]
Set Variable [ $fmide___indefinitely[1] ; Value: "" ]


