Set Variable [ $$fmide_debug_log[1] ; Value: List( $$fmide_debug_log ; Get ( CurrentHostTimestamp ) & Char( 9 ) & "START: " &

Substitute( List(
"State:	" & MBS("ScriptWorkspace.IsVisible") &		// 1=ScriptWorkspace is open
MBS("ScriptWorkspace.IsActive") &				// 1=ScriptWorkspace has focus
MBS("ScriptWorkspace.IsFocusOnScriptList") ;		// 1=ScriptList has focus, 0=ScriptList DOESN'T have focus … but WHAT DOES have focus?
"Script:	" & MBS("ScriptWorkspace.CurrentTab") ;	// Name of the script visible in the editor
) ; ¶ ; " | " )

) ]

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
If [ $fmide__action_name = "SelectScriptSteps" ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "script_step_range" ; $fmide_action ; $fmide__action_element_type ) ]
Else If [ $fmide__action_name = "FindScriptStep" ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "script_step_search" ; $fmide_action ; $fmide__action_element_type ) ]
Else If [ $fmide__action_name = "FindScript" ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "script_search" ; $fmide_action ; $fmide__action_element_type ) ]
Else If [ $fmide__action_name = "GoToScript" or
$fmide__action_name = "OpenScript" or
$fmide__action_name = "SelectScript" or
$fmide__action_name = "SelectScriptFolder" or
0 ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "script_name" ; $fmide_action ; $fmide__action_element_type ) ]
Else
End If
End If

# Params
Set Variable [ $fmide___by[1] ; Value: JSONGetElement ( $fmide_action ; "by" ) ]
Set Variable [ $fmide___script_name[1] ; Value: JSONGetElement ( $fmide_action ; "script_name" ) ]
Set Variable [ $fmide___script_name_stub[1] ; Value: JSONGetElement ( $fmide_action ; "script_name_stub" ) ]
Set Variable [ $fmide___script_id[1] ; Value: JSONGetElement ( $fmide_action ; "script_id" ) ]
Set Variable [ $fmide___script_number[1] ; Value: JSONGetElement ( $fmide_action ; "script_number" ) ]

# Calculations
If [ $fmide___by = "name" ]
Set Variable [ $fmide___script_name[1] ; Value: Evaluate ( $fmide___script_name ) ]
Set Variable [ $fmide___script_name_stub[1] ; Value: Evaluate ( $fmide___script_name_stub ) ]
End If
Set Variable [ $fmide___script_id[1] ; Value: Evaluate ( $fmide___script_id ) ]
Set Variable [ $fmide___script_number[1] ; Value: Evaluate ( $fmide___script_number ) ]

# Feat #139 Interpret negative numbers 'from the end' (-1 -> n)
Set Variable [ $fmide___script_number[1] ; Value: Case (
$fmide___script_number < 0 ; ValueCount ( ScriptIDs ( "" ) )+1 + $fmide___script_number ;
$fmide___script_number 
) ]

# Lookup script name if necessary - from name_stub or id or number
Set Variable [ $fmide___script_name[1] ; Value: Case(

not IsEmpty ( $fmide___script_name ) ;
  $fmide___script_name ;

not IsEmpty ( $fmide___script_name_stub ) ; Let([ /* Lookup script_name from script_name_stub */

  vScriptNames = ScriptNames ( "" ) ; 
  vScriptNumber = ValueCount( Left( vScriptNames ; Position( ¶ & vScriptNames ; ¶ & $fmide___script_name_stub ; 1 ; 1 ) ) )

  ];

  Case( vScriptNumber ; GetValue ( vScriptNames ; vScriptNumber ) )

  ) ;


not IsEmpty ( $fmide___script_id ) ; Let([ /* Lookup script_name from script_id */

  vScriptIDs = ScriptIDs ( "" ) ; 
  vScriptNames = ScriptNames ( "" ) ; 
  vScriptNumber = ValueCount( Left( vScriptIds ; Position( ¶ & vScriptIds ; ¶ & $fmide___script_id & ¶ ; 1 ; 1 ) ) )

  ];

  Case( vScriptNumber ; GetValue ( vScriptNames ; vScriptNumber ) )

  ) ;

not IsEmpty ( $fmide___script_number ) ; 
  GetValue ( ScriptNames ( "" )  ; $fmide___script_number )

) ]

# Params
Set Variable [ $fmide___script_step_range[1] ; Value: Evaluate ( JSONGetElement ( $fmide_action ; "script_step_range" ) ) ]
If [ not IsEmpty ( $fmide___script_step_range ) ]
Set Variable [ $fmide___script_step_range[1] ; Value: Substitute( $fmide___script_step_range ; ["…" ; ¶] ; ["..." ; ¶] ; [".." ; ¶] ) ]
Set Variable [ $fmide___script_step_number[1] ; Value: +GetValue( $fmide___script_step_range ; 1 ) ]
Set Variable [ $fmide___script_step_number_to[1] ; Value: +GetValue( $fmide___script_step_range ; 2 ) ]
Else
Set Variable [ $fmide___script_step_number[1] ; Value: +JSONGetElement ( $fmide_action ; "script_step_number" ) ]
Set Variable [ $fmide___script_step_number_to[1] ; Value: +JSONGetElement ( $fmide_action ; "script_step_number_to" ) ]
End If

# Defaults / Calculations
Set Variable [ $fmide___script_step_number[1] ; Value: Case( 

IsEmpty( $fmide___script_step_number ) ; 1 ;

Right ( $fmide___script_step_number ; 1 ) ≠ "%" ; Evaluate( $fmide___script_step_number );

Let(
[

¢percent = GetAsNumber( $fmide___script_step_number ) ;
¢n = MBS("ScriptWorkspace.LineCount") ;
¢m = Floor ( (¢n-1) * ¢percent / 100 )

];

Case( ¢percent ≥ 0 ; 1 + ¢m ; ¢n - ¢m )

)) ]
Set Variable [ $fmide___script_step_number_to[1] ; Value: Case( 

IsEmpty( $fmide___script_step_number_to ) ; "" ;

Right ( $fmide___script_step_number_to ; 1 ) ≠ "%" ; Evaluate( $fmide___script_step_number_to );

Let(
[

¢percent = GetAsNumber( $fmide___script_step_number_to ) ;
¢n = MBS("ScriptWorkspace.LineCount") ;
¢m = Floor ( (¢n-1) * ¢percent / 100 )

];

Case( ¢percent ≥ 0 ; 1 + ¢m ; ¢n - ¢m )

)) ]

