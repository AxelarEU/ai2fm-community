Else If [ $fmide__action_name = "RunMenuCommand" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#run-menu-command

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "path" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___path[1] ; Value: JSONGetElement ( $fmide_action ; "path" ) ]
Set Variable [ $fmide___delay[1] ; Value: JSONGetElement ( $fmide_action ; "delay" ) ]
Set Variable [ $fmide___pause[1] ; Value: JSONGetElement ( $fmide_action ; "pause" ) ]

# Calculations
Set Variable [ $fmide___path[1] ; Value: Evaluate ( $fmide___path ) ]
Set Variable [ $fmide___delay[1] ; Value: Evaluate ( $fmide___delay ) ]
Set Variable [ $fmide___pause[1] ; Value: Evaluate ( $fmide___pause ) ]

# Defaults
If [ not IsEmpty ( $fmide___pause ) and IsEmpty ( $fmide___delay ) ]
# Pause -> delay for the time of the pause, so that the event occurs in the pause
Set Variable [ $fmide___delay[1] ; Value: $fmide___pause ]
Else If [ IsEmpty ( $fmide___delay ) ]
# Always pause momentarily, if there is no specific delayed event
Set Variable [ $fmide___delay[1] ; Value: 1/100 ]
Set Variable [ $fmide___pause[1] ; Value: $fmide___delay ]
End If

# Action
Set Variable [ $fmide___r[1] ; Value: MBS( "Menubar.RunMenuCommand"; $fmide___path ; $fmide___delay ) ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

vIsError = MBS("IsError") ;
$$fmide_get_last_error_detail = Case( vIsError ; $fmide___r ) ;
$fmide__error_thrown = vIsError

];

vIsError

) ]
# Pause, if necessary, in order for the event to take acton (menus are freed up during a pause)
If [ not IsEmpty ( $fmide___pause ) and not $$fmide_get_last_error ]
# Unless the event has been delayed, it occurs during this pause
Pause/Resume Script [ Duration (seconds): $fmide___pause ]
End If

# Reset Vars
Set Variable [ $fmide___delay[1] ; Value: "" ]
Set Variable [ $fmide___pause[1] ; Value: "" ]
Set Variable [ $fmide___path[1] ; Value: "" ]
Set Variable [ $fmide___r[1] ; Value: "" ]


