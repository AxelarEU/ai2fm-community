# fmIDE GetMacro.«macro_name» -> fmIDE GetMacro.macro_name = «macro_name»
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}"
;["macro_name" ; Quote ( $fmide___action_keys ) ; JSONString]
) ]

