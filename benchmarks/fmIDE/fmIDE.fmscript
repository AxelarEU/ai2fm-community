Else If [ $fmide__action_name = "CommitRecordsRequests" or $fmide__action_name = "CommitRecords" or $fmide__action_name = "Commit" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#commit-records

# Params
Set Variable [ $fmide___with_dialog[1] ; Value: JSONGetElement ( $fmide_action ; "with_dialog" ) ]
Set Variable [ $fmide___skip_data_entry_validation[1] ; Value: JSONGetElement ( $fmide_action ; "skip_data_entry_validation" ) ]
Set Variable [ $fmide___override_ess_locking_conflicts[1] ; Value: JSONGetElement ( $fmide_action ; "override_ess_locking_conflicts" ) ]

# Calculations
Set Variable [ $fmide___with_dialog[1] ; Value: Evaluate ( $fmide___with_dialog ) ]
Set Variable [ $fmide___skip_data_entry_validation[1] ; Value: Evaluate ( $fmide___skip_data_entry_validation ) ]
Set Variable [ $fmide___override_ess_locking_conflicts[1] ; Value: Evaluate ( $fmide___override_ess_locking_conflicts ) ]

# Action
If [ $fmide___override_ess_locking_conflicts ]
# With override ESS conflicts
If [ $fmide___skip_data_entry_validation ]
# With validation
If [ $fmide___with_dialog ]
# With dialog
Commit Records/Requests [ Skip data entry validation ; With dialog: On ; Force Commit ]
Else
# No dialog
Commit Records/Requests [ Skip data entry validation ; With dialog: Off ; Force Commit ]
End If
Else
# No validation
If [ $fmide___with_dialog ]
# With dialog
Commit Records/Requests [ With dialog: On ; Force Commit ]
Else
# No dialog
Commit Records/Requests [ With dialog: Off ; Force Commit ]
End If
End If
Else
# No override ESS conflicts
If [ $fmide___skip_data_entry_validation ]
# With validation
If [ $fmide___with_dialog ]
# With dialog
Commit Records/Requests [ Skip data entry validation ; With dialog: On ]
Else
# No dialog
Commit Records/Requests [ Skip data entry validation ; With dialog: Off ]
End If
Else
# No validation
If [ $fmide___with_dialog ]
# With dialog
Commit Records/Requests [ With dialog: On ]
Else
# No dialog
Commit Records/Requests [ With dialog: Off ]
End If
End If
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Reset Vars
Set Variable [ $fmide___override_ess_locking_conflicts[1] ; Value: "" ]
Set Variable [ $fmide___skip_data_entry_validation[1] ; Value: "" ]
Set Variable [ $fmide___with_dialog[1] ; Value: "" ]


Else If [ $fmide__action_name = "CloseWindow" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#close-window

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "window_name" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___window_name[1] ; Value: JSONGetElement ( $fmide_action ; "window_name" ) ]
Set Variable [ $fmide___current_file[1] ; Value: JSONGetElement ( $fmide_action ; "current_file" ) ]

# Calculations
Set Variable [ $fmide___window_name[1] ; Value: Evaluate ( $fmide___window_name ) ]
Set Variable [ $fmide___current_file[1] ; Value: Evaluate ( $fmide___current_file ) ]

# Action
If [ IsEmpty ( $fmide___window_name ) ]
Close Window [ Current Window ]
Else If [ $fmide___current_file ]
Close Window [ Name: $fmide___window_name; Current file ]
Else
Close Window [ Name: $fmide___window_name ]
End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Case ( Get ( LastError ) = 112 ; "Window '" & $fmide___window_name  & "' is missing" ;  Get ( LastErrorDetail ) ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Recalculate the uuid of the current window
Set Variable [ $fmide__current_window_uuid[1] ; Value: Let(
[
¢window_id = Evaluate ( "Get ( WindowUUID )" ) ;
¢window_id = Case( ¢window_id ≠ "?" ; ¢window_id ; MBS( "Window.Current") )
];
¢window_id
) ]

# Reset Vars
Set Variable [ $fmide___current_file[1] ; Value: "" ]
Set Variable [ $fmide___window_name[1] ; Value: "" ]


Else If [ $fmide__action_name = "ConfigurePersistentData" or 
$fmide__action_name = "SetPersistentData" or 
$fmide__action_name = "DeletePersistentData" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#configure-persistent-data
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#set-persistent-data
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#delete-persistent-data

# Process Short Form
# FIXME
#> - missing Short forms with instance_id from path (like fmIDE macro actions):
#>   - Configure Persistent Data.«instance_id» = «value»
#>   - Set Persistent Data.«instance_id» = «value»
#>   - Delete Persistent Data.«instance_id»
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "instance_id" ; $fmide_action ; $fmide__action_element_type ) ]
If [ $fmide__action_name = "ConfigurePersistentData" ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( $fmide_action ; "delete" ; True ; JSONBoolean ) ]
End If
End If

# Params
Set Variable [ $fmide___instance_id[1] ; Value: JSONGetElement ( $fmide_action ; "instance_id" ) ]
Set Variable [ $fmide___calculation[1] ; Value: JSONGetElement ( $fmide_action ; "calculation" ) ]
Set Variable [ $fmide___delete[1] ; Value: JSONGetElement ( $fmide_action ; "delete" ) ]

# Calculations
Set Variable [ $fmide___instance_id[1] ; Value: Evaluate ( $fmide___instance_id ) ]
Set Variable [ $fmide___calculation[1] ; Value: Evaluate ( $fmide___calculation ) ]
Set Variable [ $fmide___delete[1] ; Value: Evaluate ( $fmide___delete ) ]

# Defaults
If [ $fmide__action_name = "DeletePersistentData" ]
Set Variable [ $fmide___delete[1] ; Value: 1 ]
End If

# Action
If [ $fmide___delete ]
# Delete Persistent Data
Configure Persistent Data [ fmIDE ; Instance ID: $fmide___instance_id ; Delete ]

Else
# Set Persistent Data
Configure Persistent Data [ fmIDE ; Instance ID: $fmide___instance_id ; Value: $fmide___calculation ]

End If
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]

# Reset Vars
Set Variable [ $fmide___delete[1] ; Value: "" ]
Set Variable [ $fmide___instance_id[1] ; Value: "" ]
Set Variable [ $fmide___calculation[1] ; Value: "" ]

Else If [ $fmide__action_name = "ConvertClipboard" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#convert-clipboard
# Convert Clipboard - converts the clipboard between xml and FileMaker objects
# Convert Clipboard ( to ) - converts the clipboard to the specified type

#  where
#    to can be one of the following values

#      empty or null - convert automatically between xml and FileMaker objects
#      auto - convert automatically between xml and FileMaker objects
#      xml - convert to xml
#      CustomFunction
#      Field
#      Layout
#      Script
#      ScriptStep
#      Table
#      ValueList

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "to" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
# [+].ConvertClipboard
#> [:]..to
Set Variable [ $fmide___to[1] ; Value: JSONGetElement ( $fmide_action ; "to" ) ]

# Defaults
Set Variable [ $fmide___to[1] ; Value: Case ( $fmide___to = "Layout"   ; "Layout12" ; $fmide___to ) ]

# Action
Set Variable [ $fmide___r[1] ; Value: Let(
[

¢ClipboardText = MBS( "Clipboard.GetText" ) ;
¢ClipboardXml = Case( not IsEmpty ( ¢ClipboardText ) ; ¢ClipboardText ; MBS( "Clipboard.GetFileMakerData" ; "auto" ) )

];

Case ( 

/* Convert clipboard object to xml (or leave as xml) */
$fmide___to = "xml" ; MBS( "Clipboard.SetText" ; ¢ClipboardXml ) ;

/* convert clipboard xml to specific object */
$fmide___to ≠ "" ;  MBS( "Clipboard.SetFileMakerData" ; ¢ClipboardXml ) ;

/* automatic - text/xml -> object */
not IsEmpty ( ¢ClipboardText ) ; MBS( "Clipboard.SetFileMakerData" ; "auto" ; ¢ClipboardText ) ;

/* automatic - object -> xml */
MBS( "Clipboard.SetText" ; MBS( "Clipboard.GetFileMakerData" ; "auto" ) )

)

) ]
# FIXME error handling

# Reset Vars
Set Variable [ $fmide___r[1] ; Value: "" ]
Set Variable [ $fmide___to[1] ; Value: "" ]

Else If [ $fmide__action_name = "Copy" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#copy

