"¶;$fmide__local_variables = List ( $fmide__local_variables ; Case( Position ( \¶ & $fmide__local_variables & \¶ ; \¶ & $fmide___target & \¶ ; 1 ; 1 ) = 0 ; $fmide___target ) ) " & 

"¶];0)"

) ]
# Set content to target field
Set Field By Name [ $fmide___target ; $fmide___target_temp ]
Set Variable [ $$fmide_get_last_error[1] ; Value: Let(
[

$$fmide_get_last_error_detail = Get ( LastErrorDetail ) ;
$fmide__error_thrown = Case ( Get ( LastError ) ; 1 )

];

Get ( LastError )

) ]
End If
End If

# Reset Vars
Set Variable [ $fmide___source_file[1] ; Value: "" ]
Set Variable [ $fmide___target[1] ; Value: "" ]
Set Variable [ $fmide___target_temp[1] ; Value: "" ]


Else If [ $fmide__action_name = "GoToAccount" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#go-to-account

# Process Short Form
If [ $fmide__action_element_type ≠ JSONObject ]
Set Variable [ $fmide_action[1] ; Value: JSONSetElement ( "{}" ; "account_name" ; $fmide_action ; $fmide__action_element_type ) ]
End If

# Params
Set Variable [ $fmide___account_name[1] ; Value: JSONGetElement ( $fmide_action ; "account_name" ) ]
Set Variable [ $fmide___by[1] ; Value: JSONGetElement ( $fmide_action ; "by" ) ]

# Calculations
If [ $fmide___by = "name" ]
Set Variable [ $fmide___account_name[1] ; Value: Evaluate ( $fmide___account_name ) ]
End If

# Action
Perform Script [ Specified: By name ; "fmIDE" ; Parameter: JSONSetElement ( "[]"
; ["[0].Store Keyboard Buffer.text" ; /*Char(9) & */$fmide___account_name ; JSONString]
; ["[1].Open Manage Security" ; "" ; JSONObject]
) ]

# Inject actions
Set Variable [ $fmide__inject_actions[1] ; Value: JSONSetElement ( "[]"
; ["[0].Store Keyboard Buffer.text" ; Char(9) & $fmide___account_name ; JSONString]
; ["[1].Open Manage Security" ; "" ; JSONObject]
) ]

# Reset Vars
Set Variable [ $fmide___account_name[1] ; Value: "" ]
