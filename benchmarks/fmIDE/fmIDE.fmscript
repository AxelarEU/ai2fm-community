Else If [ $fmide__action_name = "Press" ]
# @see wiki https://github.com/fmIDE/fmIDE/wiki/fmIDE-Actions/#press

# Params
Set Variable [ $fmide___key[1] ; Value: JSONGetElement ( $fmide_action ; "key" ) /* The key to press */ ]
Set Variable [ $fmide___command_key[1] ; Value: JSONGetElement ( $fmide_action ; "command_key" ) /* The command-key to press */ ]
Set Variable [ $fmide___option[1] ; Value: JSONGetElement ( $fmide_action ; "option" ) ]
Set Variable [ $fmide___shift[1] ; Value: JSONGetElement ( $fmide_action ; "shift" ) ]
Set Variable [ $fmide___pause[1] ; Value: JSONGetElement ( $fmide_action ; "pause" ) ]
Set Variable [ $fmide___delay[1] ; Value: JSONGetElement ( $fmide_action ; "delay" ) ]
Set Variable [ $fmide___times[1] ; Value: JSONGetElement ( $fmide_action ; "times" ) ]

# Calculations
Set Variable [ $fmide___option[1] ; Value: Evaluate ( $fmide___option ) ]
Set Variable [ $fmide___shift[1] ; Value: Evaluate ( $fmide___shift ) ]
Set Variable [ $fmide___pause[1] ; Value: Evaluate ( $fmide___pause ) ]
Set Variable [ $fmide___delay[1] ; Value: Evaluate ( $fmide___delay ) ]
Set Variable [ $fmide___times[1] ; Value: Evaluate ( $fmide___times ) ]

# Defaults
Set Variable [ $fmide___key[1] ; Value: Case( not IsEmpty( $fmide___key ) ; $fmide___key ; $fmide___command_key ) ]
Set Variable [ $fmide___command_down[1] ; Value: not IsEmpty( $fmide___command_key ) ]
Set Variable [ $fmide___times[1] ; Value: Max( 1 ; $fmide___times ) ]

If [ not IsEmpty ( $fmide___pause ) and IsEmpty ( $fmide___delay ) ]
# Pause -> delay for the time of the pause, so that the event occurs in the pause
Set Variable [ $fmide___delay[1] ; Value: $fmide___pause ]
Else If [ IsEmpty ( $fmide___pause ) ]
# Always pause momentarily, if there is no specific delayed event
Set Variable [ $fmide___pause[1] ; Value: 1/1000 ]
End If

# fixme - delay not yet implemented

# Action
If [ not IsEmpty ( $fmide___key ) ]
# One or more times
Set Variable [ $fmide___i[1] ; Value: 1 ]
Set Variable [ $fmide___n[1] ; Value: $fmide___times ]
Loop [ Flush type: Always ]
Exit Loop If [ $fmide___i > $fmide___n ]

# Loop over key_chars in keys
Set Variable [ $fmide___j[1] ; Value: 1 ]
Set Variable [ $fmide___m[1] ; Value: Length( $fmide___key ) ]
Loop [ Flush type: Always ]
Exit Loop If [ $fmide___j > $fmide___m ]
Set Variable [ $fmide___key_char[1] ; Value: Middle ( $fmide___key ; $fmide___j ; 1 ) ]
Set Variable [ $fmide___shift_down_automatic[1] ; Value: 0//not Exact ( Lower( $fmide___key_char ) ; $fmide___key_char ) ]
Set Variable [ $fmide___virtual_key[1] ; Value: Case(

$fmide___key_char = Char(8)   ; 51  ; /* BS - Backspace - Mac */
$fmide___key_char = Char(28)  ; 123 ; /* Arrow left - Mac */
$fmide___key_char = Char(29)  ; 126 ; /* Arrow up - Mac */
$fmide___key_char = Char(30)  ; 124 ; /* Arrow right - Mac */
$fmide___key_char = Char(31)  ; 125 ; /* Arrow down - Mac */
//$fmide___key_char = Char(32)  ; 49  ; /* Space - Mac */
$fmide___key_char = Char(127) ; 117 ; /* DEL - Delete - Mac */

$fmide___key_char

) ]
Set Variable [ $fmide___scan_code[1] ; Value: $fmide___virtual_key ]

Set Variable [ $fmide___r[1] ; Value: Case( $fmide___shift ; MBS( "RemoteControl.PressShiftKey" ; 1 ) )  & 
Case( $fmide___option ; MBS( "RemoteControl.PressOptionKey" ; 1 ) )  & 
Case( $fmide___command_down         ; MBS( $fmide__mbs_remote_control_press_command_or_control_key ; 1 ) )  & 
MBS( "RemoteControl.PressKey" ; $fmide___virtual_key ; $fmide___scan_code ) & 
Case( $fmide___command_down         ; MBS( $fmide__mbs_remote_control_press_command_or_control_key ; 0 ) )  &
Case( $fmide___option ; MBS( "RemoteControl.PressOptionKey" ; 0 ) )  &
Case( $fmide___shift ; MBS( "RemoteControl.PressShiftKey" ; 0 ) )  &
"" ]
# Pause, if necessary, in order for the event to take acton (menus are freed up during a pause)
If [ not IsEmpty ( $fmide___pause ) ]
# Unless the event has been delayed, it occurs during this pause
Pause/Resume Script [ Duration (seconds): $fmide___pause ]
End If

# next key
Set Variable [ $fmide___j[1] ; Value: $fmide___j + 1 ]
End Loop
Set Variable [ $fmide___i[1] ; Value: $fmide___i + 1 ]
End Loop
End If

# Reset Vars
Set Variable [ $fmide___command_down[1] ; Value: "" ]
Set Variable [ $fmide___command_key[1] ; Value: "" ]
Set Variable [ $fmide___delay[1] ; Value: "" ]
Set Variable [ $fmide___i[1] ; Value: "" ]
Set Variable [ $fmide___j[1] ; Value: "" ]
Set Variable [ $fmide___key[1] ; Value: "" ]
Set Variable [ $fmide___key_char[1] ; Value: "" ]
Set Variable [ $fmide___m[1] ; Value: "" ]
Set Variable [ $fmide___n[1] ; Value: "" ]
Set Variable [ $fmide___option[1] ; Value: "" ]
Set Variable [ $fmide___pause[1] ; Value: "" ]
Set Variable [ $fmide___r[1] ; Value: "" ]
Set Variable [ $fmide___scan_code[1] ; Value: "" ]
Set Variable [ $fmide___shift[1] ; Value: "" ]
Set Variable [ $fmide___shift_down_automatic[1] ; Value: "" ]
Set Variable [ $fmide___times[1] ; Value: "" ]
Set Variable [ $fmide___virtual_key[1] ; Value: "" ]


Else If [ $fmide__action_name = "ReadFromDataFile" ]
